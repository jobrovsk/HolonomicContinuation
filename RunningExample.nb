Cell["\<\
To find a better starting point, one may search within a particular interval \
systematically. The method works only in its parallelized version. I.e., one \
has to distribute the following values:\
\>", "Text",
 CellChangeTimes->{{3.9979462797180357`*^9, 
  3.997946344742682*^9}},ExpressionUUID->"5420ea60-7e27-464f-92cf-\
2b8ecc2b5fa1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"CloseKernels", "[", "]"}], ";", " ", 
  RowBox[{"LaunchKernels", "[", "12", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{"freecoeffs", ",", "testcoeff", ",", "funcA", ",", "funcB"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelEvaluate", "[", 
   RowBox[{"$MaxExtraPrecision", " ", "=", "10200"}], "]"}], ";", 
  RowBox[{"ParallelEvaluate", "[", 
   RowBox[{
   "Get", "[", "\"\<HolonomicContinuation/HolonomicContinuation.m\>\"", "]"}],
    "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.85746886304536*^9, 3.857468873741087*^9}, {

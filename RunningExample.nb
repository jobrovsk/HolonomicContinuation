Cell["\<\
Since  the evaluation of these functions at different points is rather slow,, \
we use the following  internal data structures based on the Horner scheme to \
speed up such evaluations for our matching routines.\
\>", "Text",
 CellChangeTimes->{{3.996983188648267*^9, 3.9969832218200693`*^9}, {
  3.998308091565394*^9, 3.998308215807378*^9}, {3.9983582291313*^9, 
  3.998358290299293*^9}},ExpressionUUID->"8735a1f3-2436-40df-bdcf-\
bb266c8e7cbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"funcA", ",", "funcB"}], "}"}], "=", 
   RowBox[{"BuildMatchExpansions", "[", 
    RowBox[{"z", ",", "s", ",", "a", ",", 
     RowBox[{"{", 
      RowBox[{
      "coeffsubsA", ",", "solA", ",", "startA", ",", "nlogsA", ",", "ncA", ",",
        "ruleA"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "coeffsubsB", ",", "startB", ",", "nlogsB", ",", "ncB", ",", "ruleB"}], 
      "}"}], ",", "tci"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9969364670962543`*^9, 3.996936474975457*^9}, {
  3.9969779524856577`*^9, 3.996977955951069*^9}, {3.996983226641588*^9, 
  3.996983231596713*^9}, {3.998924346424592*^9, 3.9989243586530657`*^9}},
 CellLabel->
  "(2) In[50]:=",ExpressionUUID->"6fb8958f-57cc-4ebd-8938-248dc696531f"],

Cell["\<\
Finally we can match at different evaluation points to determine the free \
coefficients for the expansion at s=-Infinity as follows. \
\>", "Text",
 CellChangeTimes->{{3.9973438754376087`*^9, 3.997343924110778*^9}, {
   3.997343955502597*^9, 3.997343980407823*^9}, 3.99734401207159*^9, {
   3.99835832722779*^9, 
   3.998358367428104*^9}},ExpressionUUID->"a2fe5046-a939-4452-8653-\
35c52b6ebd6c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"workingprecision1", "=", "4000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$MaxExtraPrecision", " ", "=", 
   RowBox[{"workingprecision1", "+", "200"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wmp", "=", "800"}], ";"}]}], "Input",

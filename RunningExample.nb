  3.9969819496863937`*^9}},ExpressionUUID->"fdb5fdf0-9f5b-469c-8f37-\
2f7a99753b8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deqA", "=", 
   RowBox[{"deq", "=", 
    RowBox[{"GetDEQspt", "[", 
     RowBox[{"deS0", ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", 
        RowBox[{"-", "196"}]}], "}"}], ",", "g", ",", "z", ",", 
      RowBox[{"{", "}"}]}], "]"}]}]}], ";"}]], "Input",

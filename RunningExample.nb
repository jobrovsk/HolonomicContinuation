  3.9969819496863937`*^9}},ExpressionUUID->"fdb5fdf0-9f5b-469c-8f37-\
2f7a99753b8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deqA", "=", 
   RowBox[{"deq", "=", 
    RowBox[{"GetDEQspt", "[", 
     RowBox[{"deS0", ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", 
        RowBox[{"-", "196"}]}], "}"}], ",", "g", ",", "z", ",", 
      RowBox[{"{", "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996919950536559*^9, 3.996919951097609*^9}, {
   3.996920375431654*^9, 3.996920444151181*^9}, 3.996920485231155*^9, {

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MyNormalize", "[", "f_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"var", ",", "varSubst", ",", "AA", ",", "BB"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"var", "=", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"{", "f", "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Power", "[", 
             RowBox[{"AA_", ",", "BB_"}], "]"}], "/;", 
            RowBox[{"!", 
             RowBox[{"IntegerQ", "[", "BB", "]"}]}]}], "\[Rule]", 
           RowBox[{"MP", "[", 
            RowBox[{"AA", ",", "BB"}], "]"}]}], ",", "Infinity"}], "]"}], "//",
         "Union"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"var", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"var", ",", 
         RowBox[{"Union", "[", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"{", "f", "}"}], ",", 
            RowBox[{"MyPower", "[", "__", "]"}], ",", "Infinity"}], "]"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"varSubst", "=", "var"}], ";", "\[IndentingNewLine]", 
      RowBox[{"varSubst", "=", 
       RowBox[{"varSubst", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MyPower", "[", 
           RowBox[{"A_", ",", "B_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"MyPower", "[", 
           RowBox[{"A", ",", 
            RowBox[{"Expand", "[", "B", "]"}]}], "]"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"varSubst", "=", 
       RowBox[{"varSubst", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MyPower", "[", 
           RowBox[{"A_", ",", "B_Plus"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"Apply", "[", 
           RowBox[{"Times", ",", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"MyPower", "[", 
                RowBox[{"A", ",", "#"}], "]"}], "&"}], ",", 
              RowBox[{"Apply", "[", 
               RowBox[{"List", ",", "B"}], "]"}]}], "]"}]}], "]"}]}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"varSubst", "=", 
       RowBox[{"varSubst", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MyPower", "[", 
           RowBox[{"AA_", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "BB_"}]}], "]"}], "\[Rule]", 
          RowBox[{"1", "/", 
           RowBox[{"MyPower", "[", 
            RowBox[{"AA", ",", "BB"}], "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"varSubst", "=", 
       RowBox[{"varSubst", "/.", 
        RowBox[{
         RowBox[{"MyPower", "[", 
          RowBox[{"AA_", ",", "BB_Integer"}], "]"}], "->", 
         RowBox[{"Power", "[", 
          RowBox[{"AA", ",", "BB"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 

Cell[BoxData[
 RowBox[{
  RowBox[{"DEtoREPrep", "[", 
   RowBox[{"fIn_", ",", "F_", ",", "x_", ",", "N_", ",", 
    RowBox[{"start_", ":", "5"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"fIn", "/.", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "d_", "]"}], "[", 
          RowBox[{"F", "[", "B__", "]"}], "]"}], "[", "x", "]"}], ":>", 
        RowBox[{"MySum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"F", "[", "B", "]"}], "[", "N", "]"}], 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{"N", "-", "i"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], 
           RowBox[{
            RowBox[{"MyPower", "[", 
             RowBox[{"x", ",", "N"}], "]"}], "/", 
            RowBox[{"x", "^", "d"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"N", ",", 
            RowBox[{"d", "+", "start"}], ",", "Infinity"}], "}"}]}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"f", "/.", 
       RowBox[{
        RowBox[{
         RowBox[{"F", "[", "B__", "]"}], "[", "x", "]"}], "\[Rule]", 
        RowBox[{"MySum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"F", "[", "B", "]"}], "[", "N", "]"}], 
           RowBox[{"MyPower", "[", 
            RowBox[{"x", ",", "N"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"N", ",", "start", ",", "Infinity"}], "}"}]}], "]"}]}]}]}],
      ";", "\[IndentingNewLine]", "f"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

 RowBox[{
  RowBox[{
   RowBox[{"TestCoeffInfo", "::", "usage"}], "=", 
   "\"\<TestCoeffInfo[coeff] determines the power in the expansion variable \
and the power of the log associated to the coefficient 'coeff'. For example,\n\
\nTestCoeffInfo[a2[-3]]\n\nwill give\n\n{a2[-3],-3,2}\>\""}], 
  "\[IndentingNewLine]"}]], "Input",

                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "r"}], "+", "shift", "-", "4", "+", "k", "+", 
               "\[Alpha]"}], ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
          RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"test", "=", 
      RowBox[{"Not", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "indicial1", ",", "indicial2", ",", "indicial3", ",", "indicial4"}], 
         "}"}], "===", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{"test", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"shift", "=", 
         RowBox[{"shift", "-", "1"}]}], ";", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Details\>\"", "]"}], "==", 
           "\"\<yes\>\""}], ",", 
          RowBox[{"Print", "[", "shift", "]"}]}], "]"}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"indicial1", "=", "indicial2"}], ";", "\[IndentingNewLine]", 
        RowBox[{"indicial2", "=", "indicial3"}], ";", "\[IndentingNewLine]", 
        RowBox[{"indicial3", "=", "indicial4"}], ";", "\[IndentingNewLine]", 
        RowBox[{"indicial4", "=", 
         RowBox[{"RemoveRational", "[", 
          RowBox[{"Factor", "[", 
           RowBox[{"FunctionExpand", "[", 
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Expand", "[", 
                RowBox[{
                 RowBox[{"diffeqz", " ", "/.", " ", 
                  RowBox[{
                   RowBox[{"g", "[", "z", "]"}], "->", 
                   RowBox[{"z", "^", 
                    RowBox[{"(", 
                    RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", 
                 " ", 
                 RowBox[{
                  RowBox[{
                   SuperscriptBox["g", 
                    TagBox[
                    RowBox[{"(", "n_", ")"}],
                    Derivative],
                    MultilineFunction->None], "[", "z", "]"}], "->", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"z", "^", 
                    RowBox[{"(", 
                    RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
               RowBox[{"z", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "r"}], "+", "shift", "-", "4", "+", "k", "+", 
                  "\[Alpha]"}], ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
             RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Details\>\"", "]"}], "==", 
           "\"\<yes\>\""}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"{", 
            RowBox[{
            "indicial1", ",", "indicial2", ",", "indicial3", ",", 
             "indicial4"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"test", "=", 
         RowBox[{"Not", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "indicial1", ",", "indicial2", ",", "indicial3", ",", 
             "indicial4"}], "}"}], "===", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}]}]}]}],
       "]"}], ";", "\[IndentingNewLine]", "shift"}]}], " ", "]"}]}]}], "Input",\


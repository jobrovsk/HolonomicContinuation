Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeIntegerDE", "[", 
    RowBox[{"diffeqIn_", ",", 
     RowBox[{"g_", "[", "z_", "]"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"diffeq", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"diffeq", "=", 
       RowBox[{"Apply", "[", 
        RowBox[{"List", ",", "diffeqIn"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"diffeq", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", "_", "]"}], "->", "1"}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g", 
             TagBox[
              RowBox[{"(", "_", ")"}],
              Derivative],
             MultilineFunction->None], "[", "z", "]"}], "->", "1"}]}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"diffeq", "=", 
       RowBox[{"diffeq", "/", "c"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"List", ",", "#"}], "]"}], "&"}], ",", "c"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"c", "*", 
        RowBox[{"Apply", "[", 
         RowBox[{"PolynomialLCM", ",", 
          RowBox[{"Denominator", "[", 
           RowBox[{"Flatten", "[", "c", "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"Plus", ",", "#"}], "]"}], "&"}], ",", "c"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"diffeq", "=", 
       RowBox[{"c", ".", "diffeq"}]}], ";", "\[IndentingNewLine]", 
      "diffeq"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"ExpandSeries", "[", 
   RowBox[{"f_", ",", "gIn_", ",", "x_", ",", "len_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"varL", ",", "g", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"varL", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Variables", "[", "gIn", "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"CoefficientRules", "[", 
       RowBox[{"gIn", ",", "varL"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"varL", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Apply", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"MapThread", "[", 
            RowBox[{"Power", ",", 
             RowBox[{"{", 
              RowBox[{"varL", ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
         "&"}], ",", "g"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Apply", "[", 
          RowBox[{"List", ",", 
           RowBox[{"ExpandSeriesIn", "[", 
            RowBox[{"f", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "x", ",", "len"}], "]"}]}],
           "]"}], "&"}], ",", "g"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Plus", ",", 
        RowBox[{
         RowBox[{"res", "*", "varL"}], "//", "Flatten"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "res"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

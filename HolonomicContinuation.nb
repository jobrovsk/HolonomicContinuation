       RowBox[{"stepwise", "=", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Kernels", "[", "]"}], "]"}], ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"stepwise", "===", "1"}], ",", 

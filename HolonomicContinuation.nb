Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MyNullSpaceQStandard", "[", "MIn_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"M", ",", "solold", ",", "p", ",", 
        RowBox[{"t", "=", "True"}], ",", "Mp", ",", "sol", ",", "r", ",", 
        "pprod", ",", "i", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", "=", 
        RowBox[{"PrepareRows", "/@", "MIn"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"solold", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"NextPrime", "[", 
         RowBox[{"Developer`$MaxMachineInteger", "^", "19"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{"t", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Mp", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{"M", ",", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"solold", "=!=", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{
             RowBox[{"sol", "=", 
              RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"i", "=", "1"}], ",", 
               RowBox[{"i", "<=", 
                RowBox[{"Length", "[", "solold", "]"}]}], ",", 
               RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"r", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ReconstructRationalNumber", "[", 
                    RowBox[{"#", ",", "pprod"}], "]"}], "&"}], "/@", 
                  RowBox[{"solold", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Union", "[", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"Mp", ".", 
                    RowBox[{"PolynomialMod", "[", 
                    RowBox[{"r", ",", "p"}], "]"}]}], ",", "p"}], "]"}], 
                    "]"}], "===", 
                   RowBox[{"{", "0", "}"}]}], ",", 
                  RowBox[{
                   RowBox[{"sol", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"sol", ",", "r"}], "]"}]}], ";"}], ",", 
                  RowBox[{
                   RowBox[{"sol", "=", 
                    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"i", "=", 
                    RowBox[{
                    RowBox[{"Length", "[", "solold", "]"}], "+", "1"}]}], 
                   ";"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "sol", "]"}], ">", "0"}], ",", 
            RowBox[{
             RowBox[{"t", "=", "False"}], ";"}], ",", 
            RowBox[{
             RowBox[{"sol", "=", 
              RowBox[{"NullSpace", "[", 
               RowBox[{"Mp", ",", 
                RowBox[{"Modulus", "->", "p"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"sol", "===", 
                RowBox[{"{", "}"}]}], ",", 
               RowBox[{
                RowBox[{"t", "=", "False"}], ";"}], ",", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", "sol", "]"}], "<", 
                    RowBox[{"Length", "[", "solold", "]"}]}], "||", 
                   RowBox[{"solold", "===", 
                    RowBox[{"{", "}"}]}]}], ",", 
                  RowBox[{
                   RowBox[{"solold", "=", "sol"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"pprod", "=", "p"}], ";"}], ",", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "sol", "]"}], ">", 
                    RowBox[{"Length", "[", "solold", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"Print", "[", "\"\<Unlucky prime!\>\"", "]"}], 
                    ";"}], ",", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"solold", "=", 
                    RowBox[{"Apply", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ChineseRemainder", "[", 
                    RowBox[{
                    RowBox[{"{", "##", "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"pprod", ",", "p"}], "}"}]}], "]"}], "&"}], ",", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"solold", ",", "sol"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "*)"}], 
                    RowBox[{
                    RowBox[{"solold", "=", 
                    RowBox[{"Map", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ChineseRemainder", "[", 
                    RowBox[{"##", ",", 
                    RowBox[{"{", 
                    RowBox[{"pprod", ",", "p"}], "}"}]}], "]"}], "&"}], ",", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"solold", ",", "sol"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"pprod", "=", 
                    RowBox[{"p", "*", "pprod"}]}], ";"}]}], "]"}], ";"}]}], 
                 "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Number of primes: \>\"", ",", 
            RowBox[{"k", "++"}], ",", "\"\< (used time: \>\"", ",", 
            RowBox[{"TimeUsed", "[", "]"}], ",", "\"\<, prime digits: \>\"", 
            ",", 
            RowBox[{"Apply", "[", 
             RowBox[{"Plus", ",", 
              RowBox[{"DigitCount", "[", "p", "]"}]}], "]"}], ",", 
            "\"\<, CRA digits: \>\"", ",", 
            RowBox[{"Apply", "[", 
             RowBox[{"Plus", ",", 
              RowBox[{"DigitCount", "[", "pprod", "]"}]}], "]"}], ",", 
            "\"\<)\>\""}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"p", "=", 
           RowBox[{"NextPrime", "[", 
            RowBox[{"p", ",", 
             RowBox[{"-", "1"}]}], "]"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "sol"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"OptimalSplit", "[", 
   RowBox[{"list_", ",", "nsplit_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nterms", ",", "q", ",", "r", ",", "Q1", ",", "Q2"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nterms", "=", 
      RowBox[{"Length", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", ",", "r"}], "}"}], "=", 
      RowBox[{"QuotientRemainder", "[", 
       RowBox[{"nterms", ",", "nsplit"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Q1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"list", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"q", "+", "1"}], ")"}], "*", "i"}]}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"q", "+", "1"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"i", "+", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"r", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Q2", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"q", "==", "0"}], ",", 
        RowBox[{"{", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"list", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"q", "+", "1"}], ")"}], "*", "r"}], "+", 
               RowBox[{"q", "*", "i"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"q", "+", "1"}], ")"}], "*", "r"}], "+", 
               RowBox[{"q", "*", 
                RowBox[{"(", 
                 RowBox[{"i", "+", "1"}], ")"}]}]}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"nsplit", "-", "r", "-", "1"}]}], "}"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"Q1", ",", "Q2"}], "]"}]}]}], " ", "]"}]}]], "Input",

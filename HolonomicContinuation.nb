Cell[BoxData[
 RowBox[{
  RowBox[{"ExpandSeriesParaIn", "[", 
   RowBox[{"fIn_", ",", "gIn_", ",", "x_", ",", "len_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"denF", ",", "gI", ",", "fI", ",", "denG", ",", "result"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fIn", "===", "0"}], "||", 
        RowBox[{"gIn", "===", "0"}]}], ",", 
       RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fI", "=", "fIn"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gI", "=", 
      RowBox[{"CoefficientList", "[", 
       RowBox[{"gIn", ",", "x", ",", 
        RowBox[{"len", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"denF", "=", 
      RowBox[{"LCM", "@@", 
       RowBox[{"Denominator", "/@", "fI"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"denG", "=", 
      RowBox[{"LCM", "@@", 
       RowBox[{"Denominator", "/@", "gI"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gI", "=", 
      RowBox[{"denG", "*", "gI"}]}], ";", 
     RowBox[{"fI", "=", 
      RowBox[{"denF", "*", "fI"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"ListConvolve", "[", 
       RowBox[{"fI", ",", "gI", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result", "/=", 
      RowBox[{"denF", " ", "denG"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"result", ".", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"x", "^", "i"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{
            RowBox[{"Length", "[", "result", "]"}], "-", "1"}]}], "}"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", "result"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",

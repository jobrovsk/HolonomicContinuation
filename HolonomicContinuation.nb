            RowBox[{"equ", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "10", ",", 
            RowBox[{"equ", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "equ", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "/.", 
           RowBox[{
            RowBox[{"MySum", "[", 
             RowBox[{"A_", ",", 
              RowBox[{"{", 
               RowBox[{"B_", ",", "C_", ",", "D_"}], "}"}]}], "]"}], 
            "\[RuleDelayed]", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"A", "/.", 
                 RowBox[{"N", "->", 
                  RowBox[{"N", "+", "kk"}]}]}], ")"}], "//", "MyNormalize"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"kk", ",", 
                RowBox[{"-", 
                 RowBox[{"Exponent", "[", 
                  RowBox[{"#", ",", "x"}], "]"}]}], ",", "ord"}], "}"}]}], 
             "]"}]}]}], ")"}], "&"}], ",", "\[IndentingNewLine]", "equ"}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"equ", "/.", 
       RowBox[{
        RowBox[{"MyPower", "[", 
         RowBox[{"x", ",", "N"}], "]"}], "\[Rule]", "1"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Collect", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"INT", "[", "__", "]"}], "[", "_", "]"}], ",", 
           RowBox[{
            RowBox[{"ExpandTogether", "[", 

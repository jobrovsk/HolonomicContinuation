Cell[BoxData[
 RowBox[{
  RowBox[{"GetDEQsptInternal", "[", 
   RowBox[{"diffeqs_", ",", 
    RowBox[{"{", 
     RowBox[{"s_", ",", "spt_"}], "}"}], ",", "g_", ",", "z_", ",", "qlist_", 
    ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nderiv", ",", "diffeqz", ",", "n", ",", "derivsubs", ",", "Z", ",", 
      "newderiv", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nderiv", "=", 
      RowBox[{
       RowBox[{"Exponent", "[", 
        RowBox[{
         RowBox[{"diffeqs", " ", "/.", " ", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g", 
             TagBox[
              RowBox[{"(", "n_", ")"}],
              Derivative],
             MultilineFunction->None], "[", "s", "]"}], "->", 
           RowBox[{"Z", "^", "n"}]}]}], ",", "Z"}], "]"}], "+", "3"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"diffeqz", "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Not", "[", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"qlist", ",", "spt"}], "]"}], "]"}], " ", "&&", " ", 
         RowBox[{"spt", "<", "0"}]}], ",", "   ", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"diffeqs", " ", "/.", " ", 
             RowBox[{"s", "->", 
              RowBox[{"z", "+", "spt"}]}]}], " ", "/.", " ", 
            RowBox[{
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "n_", ")"}],
                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{"z", "+", "spt"}], "]"}], "->", 
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "n", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}]}]}], " ", "/.", " ", 
           
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"z", "+", "spt"}], "]"}], "->", 
            RowBox[{"g", "[", "z", "]"}]}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g", 
              TagBox[
               RowBox[{"(", "_", ")"}],
               Derivative],
              MultilineFunction->None], "[", "z", "]"}], ",", 
            RowBox[{"g", "[", "z", "]"}]}], "}"}], ",", "Expand"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Not", "[", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"qlist", ",", "spt"}], "]"}], "]"}], " ", "&&", " ", 
         RowBox[{"spt", ">", "0"}]}], ",", "   ", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"diffeqs", " ", "/.", " ", 
             RowBox[{"s", "->", 
              RowBox[{"spt", "-", "z"}]}]}], " ", "/.", " ", 
            RowBox[{
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "n_", ")"}],
                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{"spt", "-", "z"}], "]"}], "->", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", "n"}], " ", 
              RowBox[{
               SuperscriptBox["g", 
                TagBox[
                 RowBox[{"(", "n", ")"}],
                 Derivative],
                MultilineFunction->None], "[", "z", "]"}]}]}]}], " ", "/.", 
           " ", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"spt", "-", "z"}], "]"}], "->", 
            RowBox[{"g", "[", "z", "]"}]}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g", 
              TagBox[
               RowBox[{"(", "_", ")"}],
               Derivative],
              MultilineFunction->None], "[", "z", "]"}], ",", 
            RowBox[{"g", "[", "z", "]"}]}], "}"}], ",", "Expand"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"qlist", ",", "spt"}], "]"}], " ", "&&", " ", 
         RowBox[{"spt", "<", "0"}]}], ",", "     ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"derivsubs", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g", 
              TagBox[
               RowBox[{"(", "1", ")"}],
               Derivative],
              MultilineFunction->None], "[", "s", "]"}], "->", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "/", "2"}], "/", "z"}], "*", 
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "1", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", "nderiv"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newderiv", "=", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", "s", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", 
                  RowBox[{"j", "+", "1"}]}], "}"}]}], "]"}], "->", 
              RowBox[{"Expand", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"1", "/", "2"}], "/", "z"}], "*", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"derivsubs", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", "z"}], 
                 "]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"derivsubs", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"derivsubs", ",", "newderiv"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"diffeqs", " ", "/.", " ", "derivsubs"}], "/.", " ", 
             RowBox[{"s", "->", 
              RowBox[{
               RowBox[{"z", "^", "2"}], "+", "spt"}]}]}], " ", "/.", " ", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{
               RowBox[{"z", "^", "2"}], "+", "spt"}], "]"}], "->", 
             RowBox[{"g", "[", "z", "]"}]}]}], " ", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "_", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}], ",", 
             RowBox[{"g", "[", "z", "]"}]}], "}"}], ",", "Expand"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"qlist", ",", "spt"}], "]"}], " ", "&&", " ", 
         RowBox[{"spt", ">", "0"}]}], ",", "     ", 
        RowBox[{
         RowBox[{"derivsubs", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g", 
              TagBox[
               RowBox[{"(", "1", ")"}],
               Derivative],
              MultilineFunction->None], "[", "s", "]"}], "->", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "/", "2"}], "/", "z"}], "*", 
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "1", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", "nderiv"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newderiv", "=", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", "s", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", 
                  RowBox[{"j", "+", "1"}]}], "}"}]}], "]"}], "->", 
              RowBox[{"Expand", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "1"}], "/", "2"}], "/", "z"}], "*", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"derivsubs", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", "z"}], 
                 "]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"derivsubs", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"derivsubs", ",", "newderiv"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"diffeqs", " ", "/.", " ", "derivsubs"}], "/.", " ", 
             RowBox[{"s", "->", 
              RowBox[{"spt", "-", 
               RowBox[{"z", "^", "2"}]}]}]}], " ", "/.", " ", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"spt", "-", 
               RowBox[{"z", "^", "2"}]}], "]"}], "->", 
             RowBox[{"g", "[", "z", "]"}]}]}], " ", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "_", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}], ",", 
             RowBox[{"g", "[", "z", "]"}]}], "}"}], ",", "Expand"}], 
          "]"}]}]}], "  ", "\[IndentingNewLine]", "]"}]}], ";", " ", 
     "\[IndentingNewLine]", "diffeqz"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

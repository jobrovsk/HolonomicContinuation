Cell[BoxData[
 RowBox[{
  RowBox[{"GetDEQInf", "[", 
   RowBox[{"deIn_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"s_", ",", "spt_"}], "}"}], ",", " ", "g_", ",", "z_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"de", "=", "deIn"}], ",", "derivsubs", ",", "ord", ",", "sign", 
      ",", "inhompart", ",", "exp", ",", "j"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ord", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"{", "de", "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "A_", "]"}], "[", "_", "]"}], "[", 
            "_", "]"}], "\[Rule]", "A"}], ",", "Infinity"}], "]"}], ",", 
        "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"derivsubs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox["g", 
          TagBox[
           RowBox[{"(", "1", ")"}],
           Derivative],
          MultilineFunction->None], "[", "s", "]"}], "->", 
        RowBox[{
         RowBox[{"z", "^", "2"}], "*", 
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "1", ")"}],
            Derivative],
           MultilineFunction->None], "[", "z", "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sign", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"spt", "===", 
         RowBox[{"-", "Infinity"}]}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", "ord"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"derivsubs", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"derivsubs", ",", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"g", "[", "s", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", 
                RowBox[{"j", "+", "1"}]}], "}"}]}], "]"}], "->", 
            RowBox[{
             RowBox[{"-", "sign"}], "*", 
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{"z", "^", "2"}], "*", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"derivsubs", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}]}],
               "]"}]}]}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"de", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"de", " ", "/.", " ", "derivsubs"}], "/.", " ", 
          RowBox[{"s", "\[Rule]", 
           RowBox[{"sign", "/", "z"}]}]}], " ", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g", "[", "_", "]"}], "\[Rule]", 
           RowBox[{"g", "[", "z", "]"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "z", "]"}], ",", 
          RowBox[{"g", "[", "z", "]"}]}], "}"}], ",", "Expand"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"inhompart", "=", 
      RowBox[{
       RowBox[{"de", " ", "/.", " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "_", ")"}],
            Derivative],
           MultilineFunction->None], "[", "z", "]"}], "->", "0"}]}], " ", "/.",
        " ", 
       RowBox[{
        RowBox[{"g", "[", "z", "]"}], "->", "0"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"inhompart", "=!=", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"de", "=", 
         RowBox[{"de", "-", "inhompart"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"de", "=", 
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"-", "inhompart"}], ",", "z"}], "]"}], "*", "de"}], 
            "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "inhompart"}], ")"}], "*", 
             RowBox[{"D", "[", 
              RowBox[{"de", ",", "z"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"g", "[", "z", "]"}], ",", 
             RowBox[{
              SuperscriptBox["g", 
               TagBox[
                RowBox[{"(", "_", ")"}],
                Derivative],
               MultilineFunction->None], "[", "z", "]"}]}], "}"}], ",", 
           "Expand"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"Expand", "[", 
         RowBox[{"de", " ", "/.", " ", 
          RowBox[{"z", "->", 
           RowBox[{"1", "/", "z"}]}]}], "]"}], ",", "z"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"de", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "^", "exp"}], "*", "de"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"g", "[", "z", "]"}], ",", " ", 
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "z", "]"}]}], "}"}], ",", 
        "Expand"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeIntegerDE", "[", 
      RowBox[{"de", ",", 
       RowBox[{"g", "[", "z", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,

Cell[BoxData[
 RowBox[{
  RowBox[{"FindBestInterval", "[", 
   RowBox[{"list_", ",", "prec_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"newlist", ",", "minval", ",", "p", ",", "p1", ",", "p2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newlist", "=", 
      RowBox[{"Abs", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"minval", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"newlist", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"newlist", ",", "minval"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"p", "==", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"p", "+", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"p", "==", 
         RowBox[{"Length", "[", "list", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "-", "1"}], ",", "p"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"1", "<", "p", "<", 
         RowBox[{"Length", "[", "list", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "-", "1"}], ",", 
          RowBox[{"p", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Rationalize", "[", 
         RowBox[{"#", ",", "prec"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"p1", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"p2", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], " ", 
   "]"}]}]], "Input",

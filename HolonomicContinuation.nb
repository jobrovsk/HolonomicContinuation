Cell[BoxData[
 RowBox[{
  RowBox[{"GetFixedCoeffs", "[", 
   RowBox[{"M_", ",", "ncoeffs_", ",", "nlogs_", ",", "start_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"{", "}"}]}], ",", "i", ",", "j", ",", "k", ",", "n"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "M", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"M", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], " ", "&&", 
           " ", 
           RowBox[{"j", "<", 
            RowBox[{"Length", "[", 
             RowBox[{"M", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"n", "++"}], ";", 
           RowBox[{"j", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"res", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nlogs", "+", "1"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"ncoeffs", "-", "start", "+", "1"}], ")"}]}], "-", "n", 
            "-", "1"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "res"}]}], "]"}]}]], "Input",
 InitializationCell->True,

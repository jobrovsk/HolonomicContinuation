     RowBox[{"\"\<Show interval\>\"", "->", "\"\<no\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GetBestPointMatch", "[", 
   RowBox[{
   "s_", ",", "freecoeffs_", ",", "testcoeff_", ",", "delta_", ",", 
    "workingprecision1_", ",", "wmp_", ",", 
    RowBox[{"{", 
     RowBox[{"lpoint_", ",", "rpoint_"}], "}"}], ",", "nstartpts_", ",", 
    "prec_", ",", "iterations_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "interval", ",", "inipts", ",", "list", ",", "newlist", ",", "minval", 
      ",", "p", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"interval", "=", 
      RowBox[{"RefineMatchInterval", "[", 
       RowBox[{
       "s", ",", "freecoeffs", ",", "testcoeff", ",", "delta", ",", 
        "workingprecision1", ",", "wmp", ",", 
        RowBox[{"{", 
         RowBox[{"lpoint", ",", "rpoint"}], "}"}], ",", "nstartpts", ",", 
        "prec", ",", "iterations"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"inipts", "=", 
      RowBox[{"GetIniPoints", "[", 
       RowBox[{
        RowBox[{"interval", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"interval", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "nstartpts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"list", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"MatchExpansions", "[", 
               RowBox[{
               "Global`funcA", ",", "Global`funcB", ",", "s", ",", 
                "freecoeffs", ",", "testcoeff", ",", 
                RowBox[{"{", 
                 RowBox[{"#", ",", "delta"}], "}"}], ",", "workingprecision1",
                 ",", "wmp"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "10"}], "]"}], 
         "&"}], ",", "inipts"}], "]"}]}], ";", " ", 
     RowBox[{"Print", "[", "list", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newlist", "=", 
      RowBox[{"Abs", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"minval", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"newlist", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"newlist", ",", "minval"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"p", ",", "1"}], "]"}], "]"}], ",", "prec"}], "]"}], ",", 
        
        RowBox[{"list", "[", 
         RowBox[{"[", 
          RowBox[{"p", ",", "2"}], "]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Show interval\>\"", "]"}], "==", 
        "\"\<yes\>\""}], ",", 
       RowBox[{"{", 
        RowBox[{"interval", ",", "L"}], "}"}], ",", "L"}], "]"}]}]}], " ", 
   "]"}]}]}], "Input",

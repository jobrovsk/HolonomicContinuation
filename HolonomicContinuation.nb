Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelGetDEQspt", "::", "usage"}], "=", 
  "\"\<ParallelGetDEQspt[diffeqs, {s, spt}, g, z, qlist, nsplit] computes the \
same as 'GetDEQspt', but it first splits the differential equation into \
several pieces, evaluates each one of then separately in parallel, and the \
adds up the results. This allows to obtain the result much faster than with \
'GetDEQspt'. The splitting is done based on the following options.\n\nIf \
\\\"Method\\\"\[Rule]\\\"One by one\\\", then 'diffeq' is split in as many \
terms as it has, in other words, if the order of the differential equation is \
r, then 'diffeq' will be split in a list of r+2 terms (one for each \
derivative in g[s], another one for the g[s] term itself, and another one for \
the inhomogeneous part).\n\nIf \\\"Method\\\"\[Rule]\\\"Reduced split\\\", \
then 'diffeq' is split using the function 'ReducedSplit'.\n\nIf \
\\\"Method\\\"\[Rule]\\\"Optimal split\\\" (default), then 'diffeq' is split \
using the function 'OptimalSplit'\n\nIt also has the options of \
'GetDEQspt'.\>\""}]], "Input",
 InitializationCell->True,

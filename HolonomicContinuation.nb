Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "SplitDiffEq", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Method\>\"", "->", "\"\<Optimal split\>\""}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SplitDiffEq", "[", 
   RowBox[{"diffeq_", ",", "g_", ",", "s_", ",", "nsplit_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"terms", "=", 
       RowBox[{"{", "}"}]}], ",", "nterms", ",", "order", ",", "Z", ",", 
      "newnsplit", ",", "q", ",", "r", ",", "n", ",", "i", ",", "j", ",", "k",
       ",", "T0", ",", "T1", ",", "T", ",", "Q", ",", "Q0", ",", "Q1", ",", 
      "Q2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"order", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"diffeq", " ", "/.", " ", 
         RowBox[{
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "n_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "s", "]"}], "->", 
          RowBox[{"Z", "^", "n"}]}]}], ",", "Z"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "order", " ", "of", " ", "the", " ", "differential", " ", "equation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"T0", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"diffeq", " ", "/.", " ", 
         RowBox[{
          RowBox[{"g", "[", "s", "]"}], "->", "0"}]}], " ", "/.", "  ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "n_", ")"}],
            Derivative],
           MultilineFunction->None], "[", "s", "]"}], "->", "0"}]}], "}"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"T1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"diffeq", ",", 
          RowBox[{"g", "[", "s", "]"}], ",", "1"}], "]"}], "*", 
        RowBox[{"g", "[", "s", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"T", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"diffeq", ",", 
           RowBox[{
            SuperscriptBox["g", 
             TagBox[
              RowBox[{"(", "k", ")"}],
              Derivative],
             MultilineFunction->None], "[", "s", "]"}], ",", "1"}], "]"}], 
         "*", 
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "k", ")"}],
            Derivative],
           MultilineFunction->None], "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "order"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"T", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"T0", ",", "T1", ",", "T"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}], "==", 
        "\"\<One by one\>\""}], ",", "          ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"T", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "T", "]"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}], "==", 
        "\"\<Reduced split\>\""}], ",", "   ", 
       RowBox[{"ReducedSplit", "[", 
        RowBox[{"T", ",", "nsplit"}], "]"}], " ", ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}], "==", 
        "\"\<Optimal split\>\""}], ",", "   ", 
       RowBox[{"OptimalSplit", "[", 
        RowBox[{"T", ",", "nsplit"}], "]"}]}], " ", "]"}]}]}], "  ", 
   "]"}]}]}], "Input",
 InitializationCell->True,

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "GetDEQspt", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Print s-point\>\"", "->", "\"\<no\>\""}], ",", 
      RowBox[{"\"\<Check indicial equation\>\"", "->", "\"\<no\>\""}], ",", 
      RowBox[{"\"\<Initial shift\>\"", "->", "7"}], ",", 
      RowBox[{"\"\<Details\>\"", "->", "\"\<no\>\""}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"GetDEQspt", "[", 
   RowBox[{"diffeqs_", ",", 
    RowBox[{"{", 
     RowBox[{"s_", ",", "spt_"}], "}"}], ",", "g_", ",", "z_", ",", "qlist_", 
    ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "diffeqz", ",", "inhompart", ",", "hompart", ",", "homdiffeqz", ",", 
      "res"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"diffeqz", "=", 
      RowBox[{"GetDEQsptInternal", "[", 
       RowBox[{"diffeqs", ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "spt"}], "}"}], ",", "g", ",", "z", ",", "qlist", 
        ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"inhompart", "=", 
      RowBox[{
       RowBox[{"diffeqz", " ", "/.", " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "_", ")"}],
            Derivative],
           MultilineFunction->None], "[", "z", "]"}], "->", "0"}]}], " ", "/.",
        " ", 
       RowBox[{
        RowBox[{"g", "[", "z", "]"}], "->", "0"}]}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "inhomogeneous", " ", "part", " ", "of", " ", "the", " ", 
       "differential", " ", "equation"}], " ", "*)"}], " ", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"hompart", "=", 
      RowBox[{"diffeqz", "-", "inhompart"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "homogeneous", " ", "part", " ", "of", " ", "the", " ", "differential", 
       " ", "equation"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"inhompart", "===", "0"}], ",", "diffeqz", ",", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"-", "inhompart"}], ",", "z"}], "]"}], "*", "hompart"}],
            "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "inhompart"}], ")"}], "*", 
            RowBox[{"D", "[", 
             RowBox[{"hompart", ",", "z"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"g", "[", "z", "]"}], ",", 
            RowBox[{
             SuperscriptBox["g", 
              TagBox[
               RowBox[{"(", "_", ")"}],
               Derivative],
              MultilineFunction->None], "[", "z", "]"}]}], "}"}], ",", 
          "Expand"}], "]"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "homogenization", " ", "of", " ", "the", " ", "differential", " ", 
       "equation", " ", 
       RowBox[{"(", 
        RowBox[{"only", " ", "if", " ", "needed"}], ")"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Print s-point\>\"", "]"}], "==", 
        "\"\<yes\>\""}], ",", 
       RowBox[{"Print", "[", "spt", "]"}], ",", "Null"}], "]"}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Check indicial equation\>\"", "]"}], 
        "==", "\"\<no\>\""}], ",", "Null", ",", 
       RowBox[{"CheckIndicial", "[", 
        RowBox[{"res", ",", "g", ",", "z", ",", "\[Alpha]", ",", 
         RowBox[{"\"\<Initial shift\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<Initial shift\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Details\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<Details\>\"", "]"}]}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeIntegerDE", "[", 
      RowBox[{"res", ",", 
       RowBox[{"g", "[", "z", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", " ", 
   "]"}]}]}], "Input",

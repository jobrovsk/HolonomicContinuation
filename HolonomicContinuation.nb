Cell[BoxData[
 RowBox[{
  RowBox[{"NumberOfInitialValues", "[", 
   RowBox[{"rec_", ",", 
    RowBox[{"g_", "[", "n_", "]"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ord", ",", "lc", ",", "root"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ord", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"rec", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"g", "[", "A_", "]"}], "->", 
          RowBox[{"A", "-", "n"}]}], ",", "Infinity"}], "]"}], "//", 
       "Max"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lc", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"rec", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"g", "[", 
         RowBox[{"ord", "+", "n"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FindIntegerRoots", "[", 
           RowBox[{"lc", ",", "n"}], "]"}], "//", "Max"}], ")"}], "-", "ord", 
        "+", "1"}], ",", "0"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9716698828796473`*^9, 3.971669886007452*^9}, {
  3.9969209217998953`*^9, 3.9969209437123632`*^9}, {3.9969210394441566`*^9, 
  3.996921045560182*^9}},ExpressionUUID->"c459eab2-41ba-45d9-8103-\

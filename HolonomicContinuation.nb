Cell[BoxData[{
 RowBox[{"Clear", "[", "JEvalHorner", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JEvalHorner", "[", 
    RowBox[{
     RowBox[{"plist_", "?", "VectorQ"}], ",", 
     RowBox[{"val_", "?", "IntegerQ"}]}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"val", " ", "#1"}], "+", "#2"}], ")"}], "&"}], ",", "0", ",", 
     "plist"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "JRecToListHorner", "]"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JRecToListHorner", "[", 
   RowBox[{"recIn_Equal", ",", 
    RowBox[{"initial_", "?", "VectorQ"}], ",", 
    RowBox[{"start_", "?", "IntegerQ"}], ",", 
    RowBox[{"end_", "?", "IntegerQ"}], ",", 
    RowBox[{"g_", "[", "n_Symbol", "]"}]}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hh", ",", "rec", ",", "k", ",", "i", ",", "AAA", ",", "curNum", ",", 
      "den", ",", "ord", ",", 
      RowBox[{"values", "=", 
       RowBox[{"{", "}"}]}], ",", "recK", ",", "oldDen", ",", "mul", ",", 
      "vecGCD", ",", "lIndex", ",", "tIndex"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tIndex", ",", "lIndex"}], "}"}], "=", 
      RowBox[{"MinMax", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"recIn", ",", 
         RowBox[{
          RowBox[{"g", "[", "AAA_", "]"}], "->", 
          RowBox[{"AAA", "-", "n"}]}], ",", "Infinity"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"ord", "=", 
      RowBox[{"lIndex", "-", "tIndex"}]}], ";", "\n", "\t", 
     RowBox[{"rec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"recIn", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{"recIn", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"g", "[", 
           RowBox[{"i", "+", "n"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "tIndex", ",", "lIndex"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"rec", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Reverse", "[", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{"#", ",", "n"}], "]"}], "]"}], "&"}], "/@", "rec"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"hh", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"recIn", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", 
         RowBox[{"recIn", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
        RowBox[{
         RowBox[{"g", "[", "_", "]"}], "->", "0"}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"den", "=", 
      RowBox[{"LCM", "@@", 
       RowBox[{"Denominator", "/@", 
        RowBox[{"initial", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           RowBox[{"UpTo", "[", "ord", "]"}]}], "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"curNum", "=", 
      RowBox[{"den", " ", 
       RowBox[{"initial", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"UpTo", "[", "ord", "]"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"JPrint", "[", 
         RowBox[{"k", ",", "\"\< : \>\""}], "]"}], ";", 
        RowBox[{"JPrint", "[", 
         RowBox[{"\"\< combinded: \>\"", ",", 
          RowBox[{
           RowBox[{"Timing", "[", "\t", "\[IndentingNewLine]", "\t\t", 
            RowBox[{
             RowBox[{"recK", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"JEvalHorner", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"k", "-", "lIndex"}]}], "]"}], "&"}], "/@", 
               RowBox[{"rec", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"Length", "[", "curNum", "]"}]}], "-", "1"}], 
                  ";;"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
             "\t\t", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"values", ",", 
               RowBox[{
                RowBox[{"recK", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", 
                   RowBox[{"-", "2"}]}], "]"}], "]"}], ".", "curNum"}]}], 
              "]"}], ";", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "/=", "den"}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "+=", 
              RowBox[{"(", 
               RowBox[{"hh", "/.", 
                RowBox[{"n", "->", 
                 RowBox[{"(", 
                  RowBox[{"k", "-", "lIndex"}], ")"}]}]}], ")"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "/=", 
              RowBox[{"-", 
               RowBox[{"recK", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"oldDen", "=", "den"}], ";", "\[IndentingNewLine]", 
             "\t\t", 
             RowBox[{"den", "=", 
              RowBox[{"LCM", "[", 
               RowBox[{"oldDen", ",", 
                RowBox[{"Denominator", "[", 
                 RowBox[{"values", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"mul", "=", 
              RowBox[{"den", "/", 
               RowBox[{"Denominator", "[", 
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"curNum", ",", 
               RowBox[{"mul", " ", 
                RowBox[{"Numerator", "[", 
                 RowBox[{"values", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "curNum", "]"}], ">", "ord"}], ",", 
               RowBox[{"curNum", "=", 
                RowBox[{"Rest", "[", "curNum", "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"mul", "=", 
              RowBox[{"den", "/", "oldDen"}]}], ";", "\[IndentingNewLine]", 
             "\t\t", 
             RowBox[{
              RowBox[{"curNum", "[", 
               RowBox[{"[", 
                RowBox[{";;", 
                 RowBox[{"-", "2"}]}], "]"}], "]"}], "*=", "mul"}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"k", ",", "50"}], "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", "\t\t\t", 
               RowBox[{
                RowBox[{"vecGCD", "=", 
                 RowBox[{"GCD", "[", 
                  RowBox[{
                   RowBox[{"GCD", "@@", "curNum"}], ",", "den"}], "]"}]}], 
                ";", "\[IndentingNewLine]", "\t\t\t ", 
                RowBox[{"(*", 
                 RowBox[{
                 "is", " ", "here", " ", "almost", " ", "always", " ", "1"}], 
                 "*)"}], "\[IndentingNewLine]", "\t\t\t", 
                RowBox[{"curNum", "/=", "vecGCD"}], ";", 
                "\[IndentingNewLine]", "\t\t\t", 
                RowBox[{"den", "/=", "vecGCD"}], ";"}]}], 
              "\[IndentingNewLine]", "\t\t", "]"}]}], "\t", 
            "\[IndentingNewLine]", "\t", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"start", "+", 
          RowBox[{"Min", "[", 
           RowBox[{"ord", ",", 
            RowBox[{"Length", "[", "initial", "]"}]}], "]"}]}], ",", "end"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\t", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Return", "[", "values", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Code",
 InitializationCell->False,

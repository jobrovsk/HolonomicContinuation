Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateRelationFromRec", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"recIn_", ",", 
      RowBox[{"F_", "[", "n_", "]"}], ",", 
      RowBox[{"h_", ":", "dummy"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"initialSubst_", ",", "a_"}], "}"}], ",", "no_", ",", 
    "offsetNo_", ",", 
    RowBox[{"DigitPrecIn_", ":", "Infinity"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "IsParallel", ",", "SigmaFile", ",", "rec", ",", "ord", ",", "initialL", 
      ",", "varL", ",", "DigitPrec", ",", "aNo", ",", "aNoMin", ",", "aNoMax",
       ",", "seqRes", ",", "k", ",", "initialP", ",", "seqP", ",", "testNo", 
      ",", "test", ",", "check", ",", "zeroRecognition"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "FP", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "hP", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{"recIn", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"F", "->", "FP"}], ",", 
         RowBox[{"h", "->", "hP"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"ord", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"rec", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"FP", "[", "A_", "]"}], "->", 
         RowBox[{"A", "-", "n"}]}], ",", "Infinity"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ord", "=", 
      RowBox[{
       RowBox[{"Max", "[", "ord", "]"}], "-", 
       RowBox[{"Min", "[", "ord", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aNo", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"initialSubst", ",", 
        RowBox[{
         RowBox[{"a", "[", "A_", "]"}], "->", "A"}], ",", "Infinity"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aNoMin", "=", 
      RowBox[{"aNo", "//", "Min"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aNoMax", "=", 
      RowBox[{"aNo", "//", "Max"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"initialL", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"a", "[", "k", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "aNoMin", ",", "aNoMax"}], "}"}]}], "]"}], "/.", 
       "initialSubst"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IntegerQ", "[", "DigitPrecIn", "]"}], "&&", 
         RowBox[{"DigitPrecIn", ">", "0"}]}], ")"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"DigitPrec", "=", "DigitPrecIn"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"DigitPrec", "=", "Infinity"}]}], "\[IndentingNewLine]", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"varL", "=", 
      RowBox[{"Variables", "[", "initialL", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"initialL", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"initialL", ",", "#"}], "]"}], "&"}], ",", "varL"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"initialL", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"List", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "varL", "]"}]}], "}"}]}], "]"}], ",", 
          "initialL"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Kernels", "[", "]"}], "=!=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<I enter the parallel mode with \>\"", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"Kernels", "[", "]"}], "]"}], ",", "\"\< kernels.\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"DistributeDefinitions", "[", 
         RowBox[{"{", 
          RowBox[{"JRecToListHorner", ",", "JEvalHorne"}], "}"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"DistributeDefinitions", "[", 
         RowBox[{"{", 
          RowBox[{
          "rec", ",", "ord", ",", "aNoMin", ",", "DigitPrec", ",", "varL", 
           ",", "h"}], "}"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"IsParallel", "=", "True"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"seqRes", "=", 
      RowBox[{"MyParallelMap", "[", 
       RowBox[{"IsParallel", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"k", ",", "initialP"}], "}"}], "=", "#"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Consider: \>\"", ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"varL", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "}"}]}], "]"}], ";", 

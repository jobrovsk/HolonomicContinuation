Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrepareHForm", "[", 
     RowBox[{"fIn_", ",", "z_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ord", ",", "f", ",", "A"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f", "=", "fIn"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ord", "=", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"{", "f", "}"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Power", "[", 
                  RowBox[{"z", ",", "A_Integer"}], "]"}], "/;", 
                 RowBox[{"A", "<", "0"}]}], ")"}], "->", "A"}], ",", 
              "Infinity"}], "]"}], "]"}], ",", "0"}], "]"}], "//", "Min"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ord", "<", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"f", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "f", "]"}], "===", "Plus"}], ",", 
             RowBox[{"Apply", "[", 
              RowBox[{"Plus", ",", 
               RowBox[{
                RowBox[{"Apply", "[", 
                 RowBox[{"List", ",", "f"}], "]"}], 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "ord"}], ")"}]}]}]}], "]"}], ",", 
             RowBox[{"f", " ", 
              RowBox[{"z", "^", 
               RowBox[{"(", 
                RowBox[{"-", "ord"}], ")"}]}]}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HornerFormH", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"CoefficientList", "[", 
            RowBox[{"f", ",", "z"}], "]"}], "//", "Reverse"}], ",", "z"}], 
         "]"}], 
        RowBox[{"z", "^", "ord"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}]], "Input",

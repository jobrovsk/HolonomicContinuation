Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MyCoefficientRules", "[", 
    RowBox[{"f_List", ",", "varL_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"expL", ",", "res", ",", "coeffL"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coeffL", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"f", ",", "varL"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expL", "=", 
       RowBox[{"Apply", "[", 
        RowBox[{"Union", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "coeffL", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coeffL", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"res", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"coeffL", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "===", 
                 RowBox[{"expL", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], "&"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "coeffL", "]"}]}], "}"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"res", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", "===", 
                 RowBox[{"{", "}"}]}], ",", "0", ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "&"}], ",", 
             "res"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"expL", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "->", "res"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "expL", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "coeffL"}]}], "\[IndentingNewLine]", "]"}]}], 

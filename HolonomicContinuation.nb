Cell[BoxData[
 RowBox[{
  RowBox[{"FindIntegerRoots", "[", 
   RowBox[{"f_", ",", "d_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "degrees", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"degrees", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", 
        RowBox[{"f", "//", "FactorList"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"degrees", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"degrees", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exponent", "[", 
            RowBox[{"#", ",", "d"}], "]"}], "===", "1"}], ")"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"degrees", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"d", "/.", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "\[Equal]", "0"}], ")"}], ",", "d"}], "]"}], 
            "&"}], ",", "degrees"}], "]"}]}], "/.", " ", "\n", "        ", 
        RowBox[{"d", "->", " ", 
         RowBox[{"{", "}"}]}]}], "//", "Flatten"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"degrees", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"degrees", ",", " ", "IntegerQ"}], " ", "]"}]}], ";", 
     "\[IndentingNewLine]", "degrees"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

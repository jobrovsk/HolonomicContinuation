Cell[BoxData[
 RowBox[{
  RowBox[{"LinearCollect", "[", 
   RowBox[{"fIn_", ",", " ", "varL_", ",", " ", "Fu_"}], "]"}], " ", ":=", 
  "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"subst", ",", " ", "f", ",", " ", "const", ",", "varLL"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "fIn", "]"}], "===", "List"}], "||", 

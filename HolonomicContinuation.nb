Cell[BoxData[
 RowBox[{
  RowBox[{"GetBestMatchSetUp2", "[", 
   RowBox[{
   "s_", ",", "freecoeffs_", ",", "testcoeff_", ",", "deltalist_", ",", 
    "workingprecision1_", ",", "wmp_", ",", 
    RowBox[{"{", 
     RowBox[{"lpoint_", ",", "rpoint_"}], "}"}], ",", "nstartpts_", ",", 
    "prec_", ",", 

              RowBox[{"#", ",", "x", ",", "0"}], "]"}], "]"}], "&"}]}], "]"}],
          "&"}], ",", "equ"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"Plus", ",", "equ"}], "]"}], ",", 
        RowBox[{
         RowBox[{"INT", "[", "__", "]"}], "[", "_", "]"}], ",", 
        RowBox[{
         RowBox[{"ExpandTogether", "[", "#", "]"}], "&"}]}], "]"}]}], ";", 

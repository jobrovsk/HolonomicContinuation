Cell[BoxData[
 RowBox[{
  RowBox[{"RefineMatchInterval", "[", 
   RowBox[{
   "s_", ",", "freecoeffs_", ",", "testcoeff_", ",", "delta_", ",", 
    "workingprecision1_", ",", "wmp_", ",", 
    RowBox[{"{", 
     RowBox[{"lpoint_", ",", "rpoint_"}], "}"}], ",", "nstartpts_", ",", 
    "prec_", ",", "iterations_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"inipts", ",", "try", ",", "i", ",", "interval"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DistributeDefinitions", "[", 
      RowBox[{"{", 
       RowBox[{
       "freecoeffs", ",", "testcoeff", ",", "workingprecision1", ",", "wmp"}],
        "}"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"inipts", "=", 
      RowBox[{"GetIniPoints", "[", 
       RowBox[{"lpoint", ",", "rpoint", ",", "nstartpts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "iterations"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"try", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{"MatchExpansions", "[", 
                  RowBox[{
                  "Global`funcA", ",", "Global`funcB", ",", "s", ",", 
                   "freecoeffs", ",", "testcoeff", ",", 
                   RowBox[{"{", 
                    RowBox[{"#", ",", "delta"}], "}"}], ",", 
                   "workingprecision1", ",", "wmp"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "10"}], "]"}], 
            "&"}], ",", "inipts"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"interval", "=", 
         RowBox[{"FindBestInterval", "[", 
          RowBox[{"try", ",", "prec"}], "]"}]}], ";", " ", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Interval from interation \>\"", ",", "i", ",", "\"\<: \>\"", 
          ",", "interval"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"inipts", "=", 
         RowBox[{"GetIniPoints", "[", 
          RowBox[{
           RowBox[{"interval", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"interval", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "nstartpts"}], "]"}]}]}]}], 
      " ", "]"}], ";", "\[IndentingNewLine]", "interval"}]}], " ", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.845459506905033*^9, 3.845459571770331*^9}, {

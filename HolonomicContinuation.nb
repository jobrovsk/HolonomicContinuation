Cell[BoxData[
 RowBox[{
  RowBox[{"DEtoREInternal", "[", 
   RowBox[{"equIn_", ",", "INT_", ",", "x_", ",", "N_", ",", "ordIn_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "equ", ",", "den", ",", "A", ",", "B", ",", "C", ",", "D", ",", "kk", 

          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"TimeConstrained", "[", 
              RowBox[{
               RowBox[{"Factor", "[", "#", "]"}], ",", "10", ",", "#"}], 
              "]"}], "&"}], ",", 
            RowBox[{"equ", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"TimeConstrained", "[", 

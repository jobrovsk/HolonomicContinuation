     RowBox[{"iter1_", ",", "iter2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bestsetup", ",", "bestdelta", ",", "interval", ",", "extraiters", ",", 
      "T", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bestsetup", "=", 
      RowBox[{"GetBestMatchSetUp", "[", 
       RowBox[{
       "s", ",", "freecoeffs", ",", "testcoeff", ",", "deltalist", ",", 
        "workingprecision1", ",", "wmp", ",", 
        RowBox[{"{", 
         RowBox[{"lpoint", ",", "rpoint"}], "}"}], ",", "nstartpts", ",", 
        "prec", ",", "iter1", ",", 
        RowBox[{"\"\<Full list\>\"", "->", "\"\<yes\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bestdelta", "=", 
      RowBox[{"bestsetup", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Best value of delta:\>\"", ",", "bestdelta"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"interval", "=", 
      RowBox[{"bestsetup", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Best interval for this value of delta: \>\"", ",", "interval"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"extraiters", "=", 
      RowBox[{"iter2", "-", "iter1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"T", "=", 

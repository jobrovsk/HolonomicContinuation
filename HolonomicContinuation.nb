Cell[BoxData[
 RowBox[{
  RowBox[{"DEToRE", "[", 
   RowBox[{"de_Equal", ",", "F_", ",", "H_", ",", "x_", ",", "N_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rec", ",", "ord"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rec", "=", 
      RowBox[{
       RowBox[{"de", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"de", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{
       RowBox[{"rec", "/.", 
        RowBox[{"F", "->", 
         RowBox[{"FF", "[", "1", "]"}]}]}], "/.", 
       RowBox[{"H", "->", 
        RowBox[{"FF", "[", "2", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"ord", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"{", "de", "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "A_", "]"}], "[", "_", "]"}], "[", 
            "_", "]"}], "\[Rule]", "A"}], ",", "Infinity"}], "]"}], ",", 
        "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{"DEtoREPrep", "[", 
       RowBox[{"rec", ",", "FF", ",", "x", ",", "N"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{"DEtoREInternal", "[", 
       RowBox[{"rec", ",", "FF", ",", "x", ",", "N", ",", "ord"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rec", "==", "0"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"FF", "[", "1", "]"}], "->", "F"}], ",", 
        RowBox[{
         RowBox[{"FF", "[", "2", "]"}], "->", "H"}]}], "}"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.641120316986718*^9, 3.6411203571005497`*^9}, {
   3.641120468622745*^9, 3.641120498394033*^9}, {3.6411205283981647`*^9, 
   3.641120635886272*^9}, {3.641120760580844*^9, 3.641120762142228*^9}, {
   3.6411208546653547`*^9, 3.641120880905799*^9}, {3.641121152815023*^9, 
   3.641121180235379*^9}, {3.641121406312191*^9, 3.641121407229598*^9}, {
   3.6411214895523148`*^9, 3.641121491166349*^9}, {3.641533826990037*^9, 

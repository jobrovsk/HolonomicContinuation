  3.9969874873944483`*^9, 
  3.9969875091741*^9}},ExpressionUUID->"0e80da99-cff7-4924-bc7f-a1471d0bf3e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GetCoeffSubsFast", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"UseFlintByC", "->", "False"}], "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.899799414647523*^9, 3.89979941541385*^9}, {

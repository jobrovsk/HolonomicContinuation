        RowBox[{"Head", "[", "fIn", "]"}], "===", "Equal"}]}], ",", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LinearCollect", "[", 
          RowBox[{"#", ",", "varL", ",", "Fu"}], "]"}], "&"}], ",", "fIn"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"varLL", "=", 

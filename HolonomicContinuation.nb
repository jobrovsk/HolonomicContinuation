      RowBox[{"\"\<Details\>\"", "->", "\"\<no\>\""}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindIndicialShift", "[", 
   RowBox[{"diffeqz_", ",", "g_", ",", "z_", ",", "\[Alpha]_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r", ",", "j", ",", "Z", ",", "k", ",", "inishift", ",", "shift", ",", 
      "i", ",", "n", ",", "test", ",", "indicial1", ",", "indicial2", ",", 
      "indicial3", ",", "indicial4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"inishift", "=", 
      RowBox[{"OptionValue", "[", "\"\<Initial shift\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"diffeqz", " ", "/.", " ", 
         RowBox[{
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "j_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "z", "]"}], ":>", 
          RowBox[{"Z", "^", "j"}]}]}], ",", "Z"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Order", " ", "of", " ", "the", " ", "differential", " ", "equation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"shift", "=", "inishift"}], ";", "\[IndentingNewLine]", 
     RowBox[{"test", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"indicial1", "=", 
      RowBox[{"RemoveRational", "[", 
       RowBox[{"Factor", "[", 
        RowBox[{"FunctionExpand", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{
              RowBox[{"diffeqz", " ", "/.", " ", 
               RowBox[{
                RowBox[{"g", "[", "z", "]"}], "->", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", " ", 
              RowBox[{
               RowBox[{
                SuperscriptBox["g", 
                 TagBox[
                  RowBox[{"(", "n_", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "z", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "r"}], "+", "shift", "-", "1", "+", "k", "+", 
               "\[Alpha]"}], ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
          RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"indicial2", "=", 
      RowBox[{"RemoveRational", "[", 
       RowBox[{"Factor", "[", 
        RowBox[{"FunctionExpand", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{
              RowBox[{"diffeqz", " ", "/.", " ", 
               RowBox[{
                RowBox[{"g", "[", "z", "]"}], "->", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", " ", 
              RowBox[{
               RowBox[{
                SuperscriptBox["g", 
                 TagBox[
                  RowBox[{"(", "n_", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "z", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "r"}], "+", "shift", "-", "2", "+", "k", "+", 
               "\[Alpha]"}], ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
          RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"indicial3", "=", 
      RowBox[{"RemoveRational", "[", 
       RowBox[{"Factor", "[", 
        RowBox[{"FunctionExpand", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{
              RowBox[{"diffeqz", " ", "/.", " ", 
               RowBox[{
                RowBox[{"g", "[", "z", "]"}], "->", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", " ", 
              RowBox[{
               RowBox[{
                SuperscriptBox["g", 
                 TagBox[
                  RowBox[{"(", "n_", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "z", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "r"}], "+", "shift", "-", "3", "+", "k", "+", 
               "\[Alpha]"}], ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
          RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"indicial4", "=", 
      RowBox[{"RemoveRational", "[", 
       RowBox[{"Factor", "[", 
        RowBox[{"FunctionExpand", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{
              RowBox[{"diffeqz", " ", "/.", " ", 
               RowBox[{
                RowBox[{"g", "[", "z", "]"}], "->", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", " ", 
              RowBox[{
               RowBox[{
                SuperscriptBox["g", 
                 TagBox[
                  RowBox[{"(", "n_", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "z", "]"}], "->", 
               RowBox[{"D", "[", 

Cell[BoxData[
 RowBox[{
  RowBox[{"TopLogCoeffSubs", "[", 
   RowBox[{
   "initialS_", ",", "inputrec_", ",", "h_", ",", "g_", ",", "a_", ",", "n_", 
    ",", "no_", ",", "LogDeg_", ",", "maxKernels_", ",", "precision_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "substLogPart", ",", "inhomExpr", ",", "inhom", ",", "ordInhom", ",", 
      "A", ",", "initialSubst", ",", "rec", ",", "h2", ",", "i", ",", 
      "numberKernels", ",", "optimalKernels", ",", "newKernels", ",", "time", 
      ",", "substLogN"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"inhomExpr", "=", "0"}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"inhom", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"no", "+", "1"}], "}"}]}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ordInhom", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{"inputrec", " ", "/.", " ", 
       RowBox[{"h", "->", "h2"}]}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"ToExpression", "[", 
       RowBox[{
        RowBox[{"ToString", "[", "a", "]"}], "~~", 
        RowBox[{"ToString", "[", "LogDeg", "]"}]}], "]"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"initialSubst", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"initialS", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "A"}], "]"}]}], "&"}]}], 
       "]"}]}], ";", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h2", "[", "i_Integer", "]"}], ":=", 
      RowBox[{"inhom", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}]}], " ", ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"UseCCode", "===", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"time", ",", "substLogPart"}], "}"}], "=", 
        RowBox[{
         RowBox[{"GenerateRelationFromRecC", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rec", ",", 
             RowBox[{"g", "[", "n", "]"}], ",", "h2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"initialSubst", ",", "A"}], "}"}], ",", "no", ",", 
           "False", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"LogDeg", "===", "0"}], ",", "precision", ",", 
             "Infinity"}], "]"}]}], "]"}], "//", "AbsoluteTiming"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"numberKernels", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numberKernels", "<", "maxKernels"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"optimalKernels", "=", 
            RowBox[{
             RowBox[{"Variables", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
                "initialSubst"}], "]"}], "]"}], "//", "Length"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"optimalKernels", ">", "1"}], "&&", 
              RowBox[{"optimalKernels", ">", "numberKernels"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newKernels", "=", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"optimalKernels", "-", "numberKernels"}], ",", 
                 RowBox[{"maxKernels", "-", "numberKernels"}]}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Launch \>\"", ",", "newKernels", ",", 
                "\"\< kernels\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"LaunchKernels", "[", "newKernels", "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"time", ",", "substLogPart"}], "}"}], "=", 
         RowBox[{
          RowBox[{"GenerateRelationFromRec", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rec", ",", 
              RowBox[{"g", "[", "n", "]"}], ",", "h2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"initialSubst", ",", "A"}], "}"}], ",", "no", ",", "1", 
            ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"LogDeg", "===", "0"}], ",", "precision", ",", 
              "Infinity"}], "]"}]}], "]"}], "//", "AbsoluteTiming"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time needed to get top contribution: \>\"", ",", "time"}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
     RowBox[{"substLogN", "=", "substLogPart"}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"substLogN", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "2"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"substLogN", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", "precision"}], "]"}],
          "/.", 
         RowBox[{
          RowBox[{"A", "[", "b_", "]"}], ":>", 
          RowBox[{"A", "[", 
           RowBox[{"Round", "[", "b", "]"}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "substLogN", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"substRelationL", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"substRelationL", ",", "substLogN"}], "]"}]}], ";"}], " ", 
      "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"substLogN", ",", "substLogPart", ",", "inhomExpr"}], "}"}]}]}],
    " ", "]"}]}]], "Input",

    RowBox[{
     RowBox[{"equ", "=", 
      RowBox[{"LinearCollectP", "[", 
       RowBox[{"equIn", ",", 
        RowBox[{"MySum", "[", "__", "]"}], ",", 
        RowBox[{
         RowBox[{"SpecFactor", "[", 
          RowBox[{"#", ",", "0.2"}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "equ", "]"}], "===", "Plus"}], ",", 
        RowBox[{"Apply", "[", 
         RowBox[{"List", ",", "equ"}], "]"}], ",", 
        RowBox[{"{", "equ", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equ", "=", 
      RowBox[{"equ", "/.", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MySum", "[", 
           RowBox[{"A_", ",", "B_"}], "]"}], "/;", 
          RowBox[{
           RowBox[{"Head", "[", "A", "]"}], "===", "Times"}]}], ")"}], 
        "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"A", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"FreeQ", "[", 
               RowBox[{"#", ",", "x"}], "]"}]}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"B", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}], 
         RowBox[{"MySum", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{"A", ",", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"!", 
                  RowBox[{"FreeQ", "[", 
                   RowBox[{"#", ",", "x"}], "]"}]}], "&&", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"B", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ")"}]}], 
              "&"}]}], "]"}], ",", "B"}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"den", "=", 
      RowBox[{"Apply", "[", 

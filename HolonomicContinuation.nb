Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExpandDE", "[", 
    RowBox[{"deIn_", ",", "x_", ",", "no_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"de", ",", "f", ",", "g", ",", "part", ",", "res"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"de", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "deIn", "]"}], "===", "Plus"}], ",", 
         RowBox[{"Apply", "[", 
          RowBox[{"List", ",", "deIn"}], "]"}], ",", 
         RowBox[{"{", "deIn", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"part", "=", 
           RowBox[{"de", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"part", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "part", "]"}], "===", "Times"}], ",", 
             RowBox[{"Apply", "[", 
              RowBox[{"List", ",", "part"}], "]"}], ",", 
             RowBox[{"{", "part", "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"f", "=", 
           RowBox[{"Apply", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"Select", "[", 
              RowBox[{"part", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Complement", "[", 
                  RowBox[{
                   RowBox[{"Variables", "[", "#", "]"}], ",", 
                   RowBox[{"{", "x", "}"}]}], "]"}], "===", 
                 RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"g", "=", 
           RowBox[{"Apply", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"Select", "[", 
              RowBox[{"part", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Complement", "[", 
                  RowBox[{
                   RowBox[{"Variables", "[", "#", "]"}], ",", 
                   RowBox[{"{", "x", "}"}]}], "]"}], "=!=", 
                 RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"ExpandSeries", "[", 
           RowBox[{"f", ",", "g", ",", "x", ",", "no"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "de", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{"Apply", "[", 

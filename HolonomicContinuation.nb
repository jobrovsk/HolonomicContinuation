          RowBox[{"#", ",", "z"}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"funcB", "=", 
      RowBox[{"funcB", "/.", " ", "ruleB"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Output", " ", "functions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"funcA", ",", "funcB"}], "}"}]}]}], "]"}]}]], "Input",

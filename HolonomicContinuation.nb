           RowBox[{"Length", "[", 
            RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"solL", "=", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 

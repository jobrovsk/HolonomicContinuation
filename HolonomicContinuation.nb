Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrepareNSParallel", "[", 
     RowBox[{"M_", ",", "p_", ",", "no_", ",", "solNo_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ML", ",", "pL", ",", "solL", ",", "solNoNew", ",", "pprod", ",", 
        "sol"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pL", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"NextPrime", "[", 
           RowBox[{"p", ",", "k"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "no"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"solL", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Mod", "[", 

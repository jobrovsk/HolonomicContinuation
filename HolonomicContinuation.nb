    "diffeq", ",", "g", ",", "z", ",", "a", ",", "teststart", ",", 
     "testnlogs", ",", "nc", ",", "opts"}], "]"}], "//", 
   RowBox[{
    RowBox[{"ToStringForm", "[", 
     RowBox[{"#", ",", "a"}], "]"}], "&"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.939367602539919*^9, 3.939367726635503*^9}, {
   3.939537612082343*^9, 3.939537701459941*^9}, {3.9395377349556704`*^9, 
   3.9395377436096783`*^9}, {3.939537979976362*^9, 3.939537983475215*^9}, {
   3.940574921163471*^9, 3.9405749606410913`*^9}, 3.96312579769499*^9, {
   3.9654035448954477`*^9, 3.965403546919716*^9}, 3.968900573772647*^9, {

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "CheckIndicial", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Initial shift\>\"", "->", "7"}], ",", 
      RowBox[{"\"\<Details\>\"", "->", "\"\<no\>\""}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CheckIndicial", "[", 
   RowBox[{"diffeqz_", ",", "g_", ",", "z_", ",", "\[Alpha]_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r", ",", "shift", ",", "j", ",", "Z", ",", "indicial", ",", "k", ",", 
      "n", ",", "sol", ",", "solseq", ",", "integerq", ",", "halfintegerq"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{
        RowBox[{"diffeqz", " ", "/.", " ", 
         RowBox[{
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "j_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "z", "]"}], ":>", 
          RowBox[{"Z", "^", "j"}]}]}], ",", "Z"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "order", " ", "of", " ", "the", " ", "differentia", " ", "equation"}], 
      " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"shift", "=", 
      RowBox[{"FindIndicialShift", "[", 
       RowBox[{"diffeqz", ",", "g", ",", "z", ",", "\[Alpha]", ",", 
        RowBox[{"\"\<Initial shift\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<Initial shift\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Details\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<Details\>\"", "]"}]}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"indicial", "=", 
      RowBox[{"RemoveRational", "[", 
       RowBox[{"Factor", "[", 
        RowBox[{"FunctionExpand", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{
              RowBox[{"diffeqz", " ", "/.", " ", 
               RowBox[{
                RowBox[{"g", "[", "z", "]"}], "->", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Alpha]", "+", "k"}], ")"}]}]}]}], " ", "/.", " ", 
              RowBox[{
               RowBox[{
                SuperscriptBox["g", 
                 TagBox[
                  RowBox[{"(", "n_", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "z", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"\[Alpha]", "+", "k"}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "r"}], "+", "shift", "+", "k", "+", "\[Alpha]"}], 
              ")"}]}], " ", ",", "1"}], "]"}], "/.", " ", 
          RowBox[{"k", "->", "0"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"indicial", "==", "0"}], ",", "\[Alpha]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"solseq", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "sol", "]"}]}], "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "list", " ", "of", " ", "values", " ", "of", " ", "the", " ", 
       "solutions", " ", "to", " ", "the", " ", "indicial", " ", "equation"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"integerq", "=", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"solseq", ",", "IntegerQ"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "finding", " ", "out", " ", "if", " ", "all", " ", "solutions", " ", 
       "consist", " ", "of", " ", "only", " ", "integers"}], " ", "*)"}], " ",
      "\[IndentingNewLine]", 
     RowBox[{"halfintegerq", "=", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"2", "*", "solseq"}], ",", "IntegerQ"}], "]"}], " ", "&&", 
       " ", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{
         RowBox[{"2", "*", "solseq"}], ",", "OddQ"}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "finding", " ", "out", " ", "if", " ", "all", " ", "solutions", " ", 
        "consist", " ", "of", " ", "only", " ", "integers", " ", "or", " ", 
        "half"}], "-", "integers"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"sol", "!=", 
         RowBox[{"{", 
          RowBox[{"{", "}"}], "}"}]}], " ", "&&", " ", "integerq"}], ",", 
       RowBox[{
       "Print", "[", 
        "\"\<The indicial equation has only integer solutions.\>\"", "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sol", "!=", 
         RowBox[{"{", 
          RowBox[{"{", "}"}], "}"}]}], " ", "&&", " ", "halfintegerq"}], ",", 
       
       RowBox[{
       "Print", "[", 
        "\"\<The indicial equation has integer and half-integer solutions \
(only).\>\"", "]"}], ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{
       "Print", "[", 
        "\"\<The indicial equation has solutions outside of the set of \
integers and half-integers.\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "indicial"}]}], " ", "]"}]}]}], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"LogCoeffSubs", "[", 
   RowBox[{
   "substLogPartA_", ",", "inhomExprA_", ",", "initialS_", ",", "inputrec_", 
    ",", "de_", ",", "h_", ",", "g_", ",", "z_", ",", "a_", ",", "n_", ",", 
    "no_", ",", "LogDeg_", ",", "start_", ",", "maxKernels_", ",", 
    "precision_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Aabove", ",", "A", ",", "orderSubst", ",", "b", ",", "ordDE", ",", "c", 
      ",", "LogContr", ",", "LogContrD", ",", "time", ",", "ord", ",", 
      "inhomPart", ",", "inhomExpr", ",", "inhom", ",", "h2", ",", "rec", ",",
       "i", ",", "ordInhom", ",", "initialSubst", ",", "numberKernels", ",", 
      "optimalKernels", ",", "newKernels", ",", "substLogPart", ",", 
      "substLogN"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Aabove", "=", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"\"\<a\>\"", "~~", 
        RowBox[{"ToString", "[", 
         RowBox[{"LogDeg", "+", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"ToExpression", "[", 
       RowBox[{
        RowBox[{"ToString", "[", "a", "]"}], "~~", 
        RowBox[{"ToString", "[", "LogDeg", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"orderSubst", "=", "start"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ordDE", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"de", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", "b_", "]"}], "[", "g", "]"}], "[", "z", 
          "]"}], "->", "b"}], ",", "Infinity"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ordDE", "=", 
      RowBox[{"Max", "[", "ordDE", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"rec", "=", 
      RowBox[{"inputrec", " ", "/.", " ", 
       RowBox[{"h", "->", "h2"}]}]}], ";", " ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"LCM", ",", 
        RowBox[{"Denominator", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", "#", "]"}], "===", "Plus"}], ",", 
               RowBox[{"Apply", "[", 
                RowBox[{"List", ",", "#"}], "]"}], ",", "#"}], "]"}], "&"}], 
            ",", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Aabove", "[", "n", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"n", ",", "orderSubst", ",", "no"}], "}"}]}], "]"}], "/.",
              "substLogPartA"}]}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"LogContr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "z", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{"LogDeg", "+", "1"}], ")"}]}], 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"c", " ", 
               RowBox[{"Aabove", "[", "n", "]"}]}], "]"}], 
             RowBox[{"z", "^", 
              RowBox[{"(", "n", ")"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "orderSubst", ",", "no"}], "}"}]}], "]"}], "/.",
           "substLogPartA"}], ",", "z"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"LogContrD", "=", 
      RowBox[{"{", "0", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"time", ",", "LogContr"}], "}"}], "=", 
         RowBox[{
          RowBox[{"Collect", "[", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"LogContr", ",", "z"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", "z", "]"}], ",", "z"}], "}"}], ",", 
            "Expand"}], "]"}], "//", "AbsoluteTiming"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"LogContrD", ",", 
          RowBox[{"Expand", "[", 
           RowBox[{"(", 
            RowBox[{"LogContr", "/.", 
             RowBox[{
              RowBox[{"Power", "[", 
               RowBox[{
                RowBox[{"Log", "[", "z", "]"}], ",", 
                RowBox[{"LogDeg", "+", "1"}]}], "]"}], "->", "0"}]}], ")"}], 
           "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "ordDE"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"ord", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"-", 
        RowBox[{"Cases", "[", 
         RowBox[{"LogContrD", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Power", "[", 
              RowBox[{"z", ",", "b_"}], "]"}], "/;", 
             RowBox[{"b", "<", "0"}]}], ")"}], "->", "b"}], ",", "Infinity"}],
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"LogContrD", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Apply", "[", 
          RowBox[{"Plus", ",", 
           RowBox[{
            RowBox[{"Apply", "[", 
             RowBox[{"List", ",", "#"}], "]"}], 
            RowBox[{"z", "^", "ord"}]}]}], "]"}], "&"}], ",", "LogContrD"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Kernels", "[", "]"}], "=!=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"inhomPart", "=", 
        RowBox[{"ExpandDEPara", "[", 
         RowBox[{"LogContrD", ",", "z", ",", 
          RowBox[{"ord", "+", "no", "+", "200"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"inhomPart", "=", 
         RowBox[{
          RowBox[{"-", "de"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "A_", "]"}], "[", "g", "]"}], "[", 
              "z", "]"}], ":>", 
             RowBox[{"LogContrD", "[", 
              RowBox[{"[", 
               RowBox[{"A", "+", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"g", "[", "z", "]"}], "->", 
             RowBox[{"LogContrD", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"inhomPart", "=", 
         RowBox[{"ExpandDE", "[", 
          RowBox[{"inhomPart", ",", "z", ",", 
           RowBox[{"ord", "+", "no", "+", "200"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"inhomPart", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Plus", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"List", ",", "inhomPart"}], "]"}], "/", 
          RowBox[{"z", "^", "ord"}]}], "/", "c"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"inhomPart", "=", 
      RowBox[{"inhomPart", "/.", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{"z", ",", "b_"}], "]"}], "/;", 
          RowBox[{"(", 
           RowBox[{"b", ">", 
            RowBox[{"no", "+", "200"}]}], ")"}]}], ")"}], "->", "0"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"inhomExpr", "=", 
      RowBox[{"inhomExprA", "+", "inhomPart"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"inhom", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"inhomExpr", ",", 
        RowBox[{"Log", "[", "z", "]"}], ",", "LogDeg"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ordInhom", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cases", "[", 
          RowBox[{"inhom", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Power", "[", 
               RowBox[{"z", ",", "b_"}], "]"}], "/;", 
              RowBox[{"b", "<", "0"}]}], ")"}], "->", "b"}], ",", 
           "Infinity"}], "]"}]}], ",", "0"}], "]"}]}], " ", ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"inhom", "=", 
      RowBox[{"CoefficientList", "[", 
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"Plus", ",", 
          RowBox[{
           RowBox[{"Apply", "[", 
            RowBox[{"List", ",", "inhom"}], "]"}], 
           RowBox[{"z", "^", "ordInhom"}]}]}], "]"}], ",", "z"}], "]"}]}], 
     ";", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h2", "[", "i_Integer", "]"}], ":=", 
      RowBox[{"inhom", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1", "+", "ordInhom"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"initialSubst", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"initialS", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "A"}], "]"}]}], "&"}]}], 
       "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ByteCount in initialSubst: \>\"", ",", 
       RowBox[{"initialSubst", "//", "ByteCount"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"UseCCode", "===", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"time", ",", "substLogPart"}], "}"}], "=", 
        RowBox[{
         RowBox[{"GenerateRelationFromRecC", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rec", ",", 
             RowBox[{"g", "[", "n", "]"}], ",", "h2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"initialSubst", ",", "A"}], "}"}], ",", "no", ",", "True",
            ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"LogDeg", "===", "0"}], ",", "precision", ",", 
             "Infinity"}], "]"}]}], "]"}], "//", "AbsoluteTiming"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"numberKernels", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numberKernels", "<", "maxKernels"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"optimalKernels", "=", 
            RowBox[{
             RowBox[{"Variables", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
                "initialSubst"}], "]"}], "]"}], "//", "Length"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"optimalKernels", ">", "1"}], "&&", 
              RowBox[{"optimalKernels", ">", "numberKernels"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newKernels", "=", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{"optimalKernels", "-", "numberKernels"}], ",", 
                 RowBox[{"maxKernels", "-", "numberKernels"}]}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Launch \>\"", ",", "newKernels", ",", 
                "\"\< kernels\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"LaunchKernels", "[", "newKernels", "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"time", ",", "substLogPart"}], "}"}], "=", 
         RowBox[{
          RowBox[{"GenerateRelationFromRec", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rec", ",", 
              RowBox[{"g", "[", "n", "]"}], ",", "h2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"initialSubst", ",", "A"}], "}"}], ",", "no", ",", "1", 
            ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"LogDeg", "===", "0"}], ",", "precision", ",", 
              "Infinity"}], "]"}]}], "]"}], "//", "AbsoluteTiming"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time needed to get sub-log parts: \>\"", ",", "time"}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"substLogN", "=", "substLogPart"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"substLogN", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "2"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"substLogN", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", "precision"}], "]"}],
          "/.", 
         RowBox[{
          RowBox[{"A", "[", "b_", "]"}], ":>", 
          RowBox[{"A", "[", 
           RowBox[{"Round", "[", "b", "]"}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "substLogN", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"substRelationL", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"substRelationL", ",", "substLogN"}], "]"}]}], " ", "*)"}], 

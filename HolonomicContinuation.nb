        RowBox[{"fIn", " ", "/.", " ", "subst"}]}], ";", 
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"fIn", " ", "-", " ", "const"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Fu", "[", "const", "]"}], "+", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Fu", "[", 
              RowBox[{"f", " ", "/.", " ", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"Delete", "[", 
                  RowBox[{"subst", ",", " ", "i"}], "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{"subst", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], " ", "->", 
                  " ", "1"}]}], "]"}]}], "]"}], ")"}], "*", 
            RowBox[{"subst", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "subst", "]"}]}], "}"}]}], "]"}]}], 
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"f", " ", "/.", " ", 
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{"Delete", "[", 
                 RowBox[{"subst", ",", " ", "i"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{"subst", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], " ", "->", " ",
                  "1"}]}], "]"}]}], ")"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Length", "[", "subst", "]"}]}], "}"}]}], "]"}], ",", 
          "const"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"subst", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"subst", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "subst", "]"}]}], "}"}]}], "]"}], ",", 
          "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Fu", "=!=", "Identity"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"System`Parallel`$SubKernel", "===", "True"}], "||", 
             RowBox[{
              RowBox[{"Kernels", "[", "]"}], "===", 
              RowBox[{"{", "}"}]}], "||", 
             RowBox[{
              RowBox[{
               RowBox[{"ByteCount", "[", "f", "]"}], "/", 
               RowBox[{"Length", "[", "f", "]"}]}], "<", "100000"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"f", "=", 
              RowBox[{"Map", "[", 
               RowBox[{"Fu", ",", "f"}], "]"}]}], ";"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"f", "=", 
             RowBox[{"ParallelMap", "[", 
              RowBox[{"Fu", ",", "f"}], "]"}]}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"f", ".", "subst"}]}], ";", "\[IndentingNewLine]", "f"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\


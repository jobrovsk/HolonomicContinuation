   RowBox[{"IsParallel_", ",", "fu_", ",", "f_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"IsParallel", "===", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ParallelMap", "[", 
     RowBox[{"fu", ",", "f", ",", 
      RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Map", "[", 
     RowBox[{"fu", ",", "f"}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,

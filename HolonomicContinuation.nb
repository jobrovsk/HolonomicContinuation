Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GenerateRelationFromRecC", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rec_", ",", 
       RowBox[{"F_", "[", "n_", "]"}], ",", 
       RowBox[{"h_", ":", "dummy"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"initialSubstIn_", ",", "a_"}], "}"}], ",", "no_", ",", 
     "IsInhom_", ",", 
     RowBox[{"DigitPrec_", ":", "Infinity"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "result", ",", "check", ",", "maxNo", ",", "initialSubst", ",", "nu", 
       ",", "extraValue"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nu", "=", 
       RowBox[{"NumberOfInitialValues", "[", 
        RowBox[{"rec", ",", 
         RowBox[{"F", "[", "n", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"maxNo", "=", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}], ",", 
          "initialSubstIn"}], "]"}], "//", "Max"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"extraValue", "=", 
       RowBox[{"maxNo", "-", "nu"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"extraValue", "<", "5"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Warning: I do not have suffently many initial values; I need \
at least :\>\"", ",", "nu", ",", 
           "\"\<plus 5 extra values for safety/checking reasons.\>\""}], 
          "]"}], "'"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"extraValue", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"extraValue", ",", "50"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialSubst", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"initialSubstIn", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
           RowBox[{"maxNo", "-", "extraValue"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{"RecToValuesFLINT`RecToValuesFLINT", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rec", ",", 
           RowBox[{"F", "[", "n", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"initialSubst", ",", "a"}], "}"}], ",", "no", ",", 
         "DigitPrec", ",", "\n", "\t", 
         RowBox[{"\"\<Details\>\"", "->", "True"}], ",", "\n", "\t", 
         RowBox[{"\"\<NumberOfThreads\>\"", "->", "10"}], ",", "\n", "\t", 
         RowBox[{"\"\<Inhomogeneous\>\"", "->", "IsInhom"}], ",", "\n", "\t", 
         
         RowBox[{"\"\<WriteOutputToFile\>\"", "->", "False"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<Backend\>\"", "->", "\"\<rec_to_val_V2\>\""}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"a", "[", "k", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"maxNo", "-", "extraValue"}], ",", "maxNo"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"check", "/.", "initialSubstIn"}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{"check", "/.", "initialSubstIn"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{"Union", "[", "check", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Complement", "[", 
          RowBox[{"check", ",", 
           RowBox[{"{", "0", "}"}]}], "]"}], "=!=", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", "check", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"check", "/.", "initialSubstIn"}], ")"}], ",", 
            RowBox[{"(", 
             RowBox[{"check", "/.", "initialSubstIn"}], ")"}]}], "}"}], "]"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", 
          "\"\<Error: the result does not agree with the initial \
values...\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{"initialSubst", ",", "result"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,

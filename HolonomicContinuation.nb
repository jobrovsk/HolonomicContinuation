Cell[BoxData[
 RowBox[{
  RowBox[{"GetAnsatzParametersInternal", "[", 
   RowBox[{
   "diffeq_", ",", "g_", ",", "z_", ",", "a_", ",", "teststart_", ",", 
    "testnlogs_", ",", "nc_", ",", "opts___Rule"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ncoeffs", ",", "ansatz", ",", "i", ",", "j", ",", "ord", ",", "n", ",", 
      "r", ",", "deq", ",", "ansatzindeq", ",", "fv", ",", "lowestpower", ",",
       "coeffs", ",", "M", ",", "R", ",", "LogTerm", ",", "freepos", ",", 
      "freecoeffs", ",", "coeffsubz", ",", 
      RowBox[{"nlogs", "=", "testnlogs"}], ",", 
      RowBox[{"start", "=", "teststart"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ord", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"diffeq", ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g", 
             TagBox[
              RowBox[{"(", "n_", ")"}],
              Derivative],
             MultilineFunction->None], "[", "z", "]"}], "\[Rule]", "n"}], ",",
           "Infinity"}], "]"}], ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\"\<Regular Point\>\"", "/.", 
           RowBox[{"{", "opts", "}"}]}], "/.", 
          RowBox[{"Options", "[", "GetAnsatzParameters", "]"}]}], ")"}], "===",
         "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"0", ",", "i"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"ord", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"ncoeffs", "=", 
      RowBox[{"nc", "+", "100"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ansatz", " ", "=", 
      RowBox[{"Collect", "[", " ", 
       RowBox[{
        RowBox[{"Sum", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"i", ",", "j"}], "]"}], "*", 
           RowBox[{"z", "^", "j"}], "*", 
           RowBox[{
            RowBox[{"Log", "[", "z", "]"}], "^", "i"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "teststart", ",", "ncoeffs"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "testnlogs"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", "z", "]"}], ",", 
          RowBox[{"a", "[", 
           RowBox[{"_", ",", "_"}], "]"}]}], "}"}], ",", "Expand"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"deq", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{"diffeq", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"g", "[", "_", "]"}], ",", 
          RowBox[{
           SuperscriptBox["g", 
            TagBox[
             RowBox[{"(", "_", ")"}],
             Derivative],
            MultilineFunction->None], "[", "z", "]"}]}], "}"}], ",", 
        "Expand"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"deq", "=", 
      RowBox[{"deq", "/.", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{"z", ",", "r_"}], "]"}], "/;", 
          RowBox[{"r", ">", 
           RowBox[{"ord", "+", "ncoeffs", "-", "teststart"}]}]}], ")"}], 
        "\[Rule]", "0"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"ansatzindeq", " ", "=", 
      RowBox[{
       RowBox[{"deq", " ", "/.", " ", 
        RowBox[{
         RowBox[{"g", "[", "z", "]"}], " ", "->", " ", "ansatz"}]}], " ", "/.",
        " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g", 
           TagBox[
            RowBox[{"(", "k_", ")"}],
            Derivative],
           MultilineFunction->None], "[", "z", "]"}], ":>", 
         RowBox[{"Expand", "[", 
          RowBox[{"D", "[", 
           RowBox[{"ansatz", ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "k"}], "}"}]}], "]"}], "]"}]}], "}"}]}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "ansatzindeq", "]"}], "=!=", "Plus"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fv", "=", 
         RowBox[{"Expand", "[", "ansatzindeq", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fv", "=", 
         RowBox[{"fv", "/.", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Power", "[", 
              RowBox[{"z", ",", "r_"}], "]"}], "/;", 
             RowBox[{"r", ">", "ncoeffs"}]}], ")"}], "\[Rule]", "0"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fv", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fv", "=", 
           RowBox[{"fv", "+", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Expand", "[", 
               RowBox[{"ansatzindeq", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], "/.", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Power", "[", 
                  RowBox[{"z", ",", "r_"}], "]"}], "/;", 
                 RowBox[{"r", ">", "ncoeffs"}]}], ")"}], "\[Rule]", "0"}]}], 
             ")"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "ansatzindeq", "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"fv", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{"fv", ",", 
        RowBox[{"Log", "[", "z", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"lowestpower", "=", 
      RowBox[{"-", 
       RowBox[{"Exponent", "[", 
        RowBox[{
         RowBox[{"fv", " ", "/.", " ", 
          RowBox[{"z", "->", 
           RowBox[{"1", "/", "z"}]}]}], ",", "z"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"coeffs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"i", ",", "j"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "testnlogs"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "nc", ",", "teststart", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"LogTerm", "=", 
           RowBox[{"Coefficient", "[", 
            RowBox[{"fv", ",", 
             RowBox[{"Log", "[", "z", "]"}], ",", "l"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"LogTerm", ",", "z", ",", "i"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "lowestpower", ",", 
              RowBox[{"nc", "-", "teststart", "+", "lowestpower"}]}], "}"}]}],
            "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "testnlogs", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"M", ",", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"_", ",", "AA_"}], "]"}], "/;", 
            RowBox[{"AA", ">", "nc"}]}]}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"M", ",", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ",", "1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "coeffs", "]"}]}], "}"}]}], "]"}], "//", 
       "Transpose"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"RowReduce", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"freepos", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "coeffs", "]"}], "]"}], "-", "1"}], ",", 
        RowBox[{"GetFixedCoeffs", "[", 
         RowBox[{"R", ",", "nc", ",", "testnlogs", ",", "teststart"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"freecoeffs", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"coeffs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"Length", "[", "coeffs", "]"}], "-", 
            RowBox[{"freepos", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "freepos", "]"}]}], "}"}]}], "]"}], "]"}]}],
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "freecoeffs", "]"}], "==", "ord"}], ",", 
       "Null", ",", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<Warning: Amount of free coefficients DOES NOT match the order of \
the differential equation\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"coeffsubz", "=", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{"Equal", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"DeleteCases", "[", 
               RowBox[{
                RowBox[{"R", ".", "coeffs"}], ",", "0"}], "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"DeleteCases", "[", 
                  RowBox[{
                   RowBox[{"R", ".", "coeffs"}], ",", "0"}], "]"}], "]"}]}], 
               "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Variables", "[", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"R", ".", "coeffs"}], ",", "0"}], "]"}], "]"}], ",", 
            "freecoeffs"}], "]"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ansatz", "=", 
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"ansatz", "  ", "/.", " ", "coeffsubz"}], ",", 
         RowBox[{"Log", "[", "z", "]"}], ",", "Expand"}], "]"}], " ", "/.", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"z", "^", "r_"}], "/;", 
          RowBox[{"r", ">", "nc"}]}], ")"}], "->", "0"}]}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "testnlogs"}], ",", 
       RowBox[{"i", ">=", "0"}], ",", 
       RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
       RowBox[{"nlogs", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"ansatz", ",", 
             RowBox[{"Log", "[", "z", "]"}], ",", "i"}], "]"}], "===", "0"}], 
          ",", 
          RowBox[{"nlogs", "-", "1"}], ",", "nlogs"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"start", "=", 
      RowBox[{"-", 
       RowBox[{"Exponent", "[", 
        RowBox[{
         RowBox[{"ansatz", " ", "/.", " ", 
          RowBox[{"z", "->", 
           RowBox[{"1", "/", "z"}]}]}], ",", "z"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"start", ",", "nlogs", ",", "freecoeffs"}], "}"}]}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.939367602539919*^9, 3.939367726635503*^9}, {
   3.939537612082343*^9, 3.939537701459941*^9}, {3.9395377349556704`*^9, 

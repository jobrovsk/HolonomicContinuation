   3.99612560263759*^9}, {3.996125659189639*^9, 3.9961256806284657`*^9}, {
   3.9969213732401342`*^9, 3.996921397702626*^9}, {3.9969216575596724`*^9, 
   3.996921666254834*^9}, {3.9969227080917063`*^9, 3.996922718187755*^9}, {

Cell[BoxData[
 RowBox[{
  RowBox[{"ReducedSplit", "[", 
   RowBox[{"list_", ",", "nsplit_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nterms", ",", "newnsplit", ",", "q", ",", "r", ",", "Q1", ",", "Q2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nterms", "=", 
      RowBox[{"Length", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newnsplit", "=", 
      RowBox[{"FindReducedSplitValue", "[", 
       RowBox[{"nterms", ",", "nsplit"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", ",", "r"}], "}"}], "=", 
      RowBox[{"QuotientRemainder", "[", 
       RowBox[{"nterms", ",", "newnsplit"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Q1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"list", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"1", "+", 
             RowBox[{"q", "*", "i"}]}], ",", 
            RowBox[{"q", "*", 
             RowBox[{"(", 
              RowBox[{"i", "+", "1"}], ")"}]}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"newnsplit", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Q2", "=", 
      RowBox[{"{", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"list", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"1", "+", 
            RowBox[{"newnsplit", "*", "q"}]}], ",", "nterms"}], "}"}]}], 
        "]"}], "}"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"Join", "[", 
      RowBox[{"Q1", ",", "Q2"}], "]"}]}]}], " ", "]"}]}]], "Input",

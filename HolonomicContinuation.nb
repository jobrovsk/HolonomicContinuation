Cell[BoxData[
 RowBox[{
  RowBox[{"GetCoeffSubsFast", "[", 
   RowBox[{
   "initialSIn_", ",", "de_", ",", "inputrec_", ",", "g_", ",", "h_", ",", 
    "z_", ",", "a_", ",", "n_", ",", "noIn_", ",", "nlogs_", ",", "start_", 
    ",", "precision_", ",", 
    RowBox[{"maxKernels_Integer", ":", "0"}], ",", "opts___Rule"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "initialS", ",", "no", ",", "ord", ",", "initialSN", ",", "varKnown", 
      ",", "initialStep", ",", "recStep", ",", "resL", ",", "prec", ",", 
      "res", ",", "aVar"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"no", "=", "noIn"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"initialS", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", "initialSIn"}], 
          "]"}], "//", "Variables"}], ",", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "initialSIn"}], 
          "]"}], "//", "Variables"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"initialS", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"{", 
           RowBox[{"initialS", ",", "initialS"}], "}"}]}], "]"}], ",", 
        "initialSIn"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"UseCCode", "=", 
      RowBox[{
       RowBox[{"UseFlintByC", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GetCoeffSubsN", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"UseCCode", "===", "True"}], "&&", 
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"(", 
           RowBox[{"?", "\"\<RecToValuesFLINT`*\>\""}], ")"}], "]"}], "===", 
         "Missing"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Warning: the package RecToValuesFLINT is not loaded; I use the \
standard Mathematica code...\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"UseCCode", "=", "False"}]}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}], ",", 
            "initialS"}], "]"}], "]"}], "-", "30"}], ">", "no"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"no", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}], ",", 
            "initialS"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Warning: the number of initial values are larger than the \
number of values to be calculated; this might cause problems. Thus I increase \
the number to \>\"", ",", "no", ",", "\"\< guarantee correctness.\>\""}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Kernels", "[", "]"}], "=!=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ord", "=", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"de", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "A_", "]"}], "[", "_", "]"}], "[", 
              "_", "]"}], "->", "A"}], ",", "Infinity"}], "]"}], "//", 
          "Max"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"deL", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{"#", ",", "z", ",", 
              RowBox[{"no", "+", "250"}]}], "]"}], "&"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Coefficient", "[", 
               RowBox[{"de", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Derivative", "[", "k", "]"}], "[", "g", "]"}], "[",
                  "z", "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", "ord"}], "}"}]}], "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"DistributeDefinitions", "[", "deL", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"DistributeDefinitions", "[", 
         RowBox[{"ExpandSeriesParaIn", ",", "ExpandDEParaIn"}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"resL", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"initialStep", ",", "recStep"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"initialS", ",", "inputrec"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prec", "=", "Infinity"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "===", "0"}], ",", 
          RowBox[{"prec", "=", "precision"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "===", "nlogs"}], ",", "\[IndentingNewLine]", 
          RowBox[{"res", "=", 
           RowBox[{"TopLogCoeffSubs", "[", 
            RowBox[{
            "initialStep", ",", "recStep", ",", "h", ",", "g", ",", "a", ",", 
             "n", ",", "no", ",", "k", ",", "maxKernels", ",", "prec"}], 
            "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"res", "=", 
           RowBox[{"LogCoeffSubs", "[", 
            RowBox[{
            "initialStep", ",", "recStep", ",", "initialS", ",", "inputrec", 
             ",", "de", ",", "h", ",", "g", ",", "z", ",", "a", ",", "n", ",",
              "no", ",", "k", ",", "start", ",", "maxKernels", ",", "prec"}], 
            "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"resL", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"resL", ",", 
           RowBox[{"res", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"initialStep", ",", "recStep"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"res", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"res", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "nlogs", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"whyneeded", 
       RowBox[{"??", "?"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"initialSN", "=", 
      RowBox[{"N", "[", 
       RowBox[{"initialS", ",", "precision"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"resL", "=", 
      RowBox[{"N", "[", 
       RowBox[{"resL", ",", "precision"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"aVar", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"ToString", "[", "a", "]"}], "~~", 
          RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "nlogs"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aVar", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"aVar", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "[", "A_", "]"}], "->", 
           RowBox[{
            RowBox[{"aVar", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "[", 
            RowBox[{"Hold", "[", 
             RowBox[{"Round", "[", "A", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{"nlogs", "+", "1"}]}], "}"}]}], "]"}], "/.", 
        RowBox[{"Rule", "->", "RuleDelayed"}]}], "/.", 
       RowBox[{"Hold", "->", "Identity"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"initialSN", ",", "resL"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"initialSN", ",", "resL"}], "}"}], " ", "/.", "aVar"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"varKnown", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "initialS"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"resL", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"resL", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"varKnown", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"resL", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"initialSN", ",", "resL"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "resL"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,

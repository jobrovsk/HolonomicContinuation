Cell[BoxData[
 RowBox[{
  RowBox[{"BuildMatchExpansions", "[", 
   RowBox[{"z_", ",", "s_", ",", "a_", ",", 
    RowBox[{"{", 
     RowBox[{
     "coeffsubsA_", ",", "solA_", ",", "startA_", ",", "ncA_", ",", "nlogsA_",
       ",", "ruleA_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "coeffsubsB_", ",", "startB_", ",", "ncB_", ",", "nlogsB_", ",", 
      "ruleB_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"coeff_", ",", "j_", ",", "k_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"funcA", ",", "funcB", ",", "varA"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"funcA", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"BuildExpansion", "[", 
          RowBox[{
          "z", ",", "s", ",", "a", ",", "startA", ",", "ncA", ",", "nlogsA"}],
           "]"}], "/.", " ", "coeffsubsA"}], " ", "/.", " ", "solA"}], 
       ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"funcA", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{"funcA", ",", 
        RowBox[{"Log", "[", "_", "]"}], ",", 
        RowBox[{
         RowBox[{"PrepareHForm", "[", 
          RowBox[{"#", ",", "z"}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"funcA", "=", 
      RowBox[{"funcA", "/.", " ", "ruleA"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"funcB", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"BuildExpansion", "[", 
          RowBox[{
          "z", ",", "s", ",", "a", ",", "startB", ",", "ncB", ",", "nlogsB"}],
           "]"}], " ", "/.", " ", "coeffsubsB"}], ")"}], "+", 
       RowBox[{"coeff", "*", 
        RowBox[{"z", "^", "j"}], "*", 
        RowBox[{
         RowBox[{"Log", "[", "z", "]"}], "^", "k"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"varA", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{
            RowBox[{"ToString", "[", "a", "]"}], "~~", 
            RowBox[{"ToString", "[", "kk", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"kk", ",", "0", ",", "nlogsB"}], "}"}]}], "]"}], ",", 
        RowBox[{"Log", "[", "_", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"funcB", "=", 
      RowBox[{"Collect", "[", 
       RowBox[{"funcB", ",", "varA", ",", 
        RowBox[{

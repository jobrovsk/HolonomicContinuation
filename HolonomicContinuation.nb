Cell[BoxData[
 RowBox[{
  RowBox[{"BuildExpansion", "[", 
   RowBox[{
   "z_", ",", "s_", ",", "a_", ",", "start_", ",", "nc_", ",", "nlogs_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expansion", ",", "i", ",", "j", ",", "k"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expansion", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"i", ",", "k"}], "]"}], "*", 
         RowBox[{"z", "^", "k"}], "*", 
         RowBox[{
          RowBox[{"Log", "[", "z", "]"}], "^", "i"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "nlogs"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "start", ",", "nc"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 

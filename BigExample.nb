   3.998888114605618*^9, 3.998888114998062*^9}, {3.998965350109284*^9, 
   3.998965351218308*^9}, {3.998965418004949*^9, 3.9989654186034317`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"41b162dd-0058-4336-ab8d-d275caf92d1b"],

Cell["\<\

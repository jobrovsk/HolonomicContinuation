 RowBox[{
  RowBox[{"testcoeff", "=", 
   RowBox[{"a0", "[", 
    RowBox[{"-", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tci", "=", 
   RowBox[{"TestCoeffInfo", "[", "testcoeff", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9969830573665953`*^9, {3.996983343174061*^9, 3.996983344617634*^9}, {

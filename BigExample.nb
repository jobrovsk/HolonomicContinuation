5cae675c9272"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ncA", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ncB", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleA", "=", 
   RowBox[{"z", "->", 
    RowBox[{"s", "+", "196"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ruleB", "=", 
   RowBox[{"z", "->", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "s"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.85746886304536*^9, 3.857468873741087*^9}, {

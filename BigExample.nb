Notebook[{
Cell["\<\
For installation put the directory HolonomicContinuation into one of the \
directories in $Path
Then the package can be loaded by\
\>", "Text",
 CellChangeTimes->{{3.99726113395926*^9, 3.997261143118829*^9}, {
  3.99726117464085*^9, 3.997261178631219*^9}, {3.9972612939289417`*^9, 
  3.99726130972024*^9}, {3.997261575932654*^9, 
  3.9972615768506823`*^9}},ExpressionUUID->"4260dc31-66bb-4069-b203-\
99494db6ab28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "Get", "[", "\"\<HolonomicContinuation/HolonomicContinuation.m\>\"", "]"}],
    ";"}], " "}]], "Input",
 CellChangeTimes->{{3.997152380974156*^9, 3.997152391173276*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5d570bd6-0fc4-4da5-8b2e-d23c15c39641"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "HolonomicContinuation", " ", "Package", " ", "by", " ", "Abilio", " ", 
   "de", " ", "Freitas"}], ",", " ", 
  RowBox[{
   RowBox[{
   "Jakob", " ", "Obrovsky", " ", "and", " ", "Carsten", " ", "Schneider"}], ";",
    " ", 
   RowBox[{"RISC", " ", "Linz"}]}], " ", "\[LongDash]", " ", 
  RowBox[{"V", " ", "1.4", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"24", "/", "09"}], "/", "2026"}], ")"}]}]}]], "Print",

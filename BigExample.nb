}, Open  ]],

Cell["\<\
We will perform the analytic continuation for the following differential \
equation (DE) that is defined for s=0.\
\>", "Text",
 CellChangeTimes->{{3.996983472426331*^9, 3.9969835075603313`*^9}, {
  3.997261538739552*^9, 3.997261541235441*^9}, {3.999241401533453*^9, 
  3.9992414467202053`*^9}, {3.999241504784631*^9, 3.99924153773724*^9}, {
  3.9992516059757967`*^9, 
  3.999251606312448*^9}},ExpressionUUID->"953d95e1-6ad6-4db9-a6b6-\
0073392120d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"deS0", "=", 
   RowBox[{
   "Import", 
    "[", "\"\<HolonomicContinuation/exampleData/s0_vec_diffeq_3.m.gz\>\"", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"deS0", "=", 
   RowBox[{"deS0", "==", "0"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9969199651621857`*^9, 3.9969199737930593`*^9}, {
   3.9969202252974033`*^9, 3.996920236969462*^9}, {3.9969203395378523`*^9, 
   3.9969203446212378`*^9}, {3.9971524785261803`*^9, 3.997152479891707*^9}, 
   3.997170111250987*^9, 3.997170329044382*^9, {3.997170697196005*^9, 
   3.997170704642392*^9}, {3.998887419781702*^9, 3.998887428223667*^9}, 
   3.998961221890053*^9, {3.999251592129266*^9, 3.99925160252824*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"e618f890-5e64-48a3-afb6-409dcd92aec0"],

Cell["\<\
More precisely, we will carry a solution of this DE, where we have initial \
values for s=-196, to s=-Infinity. Here we need the expansion for s=-196 and \
calculate the expansion for s=-Infinity.\
\>", "Text",
 CellChangeTimes->{{3.996983512183074*^9, 3.9969835885050793`*^9}, {
  3.997261420673658*^9, 3.997261443676786*^9}, {3.997261511148014*^9, 
  3.997261536307457*^9}},ExpressionUUID->"22873a0c-521a-4ced-bf9c-\
f5edf4515d7f"],

Cell[BoxData[
 RowBox[{"SetDirectory", "[", 
  RowBox[{"NotebookDirectory", "[", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9971564857458763`*^9, 3.997156546787345*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"9ca57c8d-41b4-4aa2-96fa-e8cffe508ac8"],

Cell["\<\
Some temporary files might be generated in the current directory. In general \
they can be very large  (but not for this example). \
\>", "Text",
 CellChangeTimes->{{3.9972413843915033`*^9, 3.997241396726499*^9}, 
   3.997939386092222*^9},ExpressionUUID->"b22c87cf-4a11-41a7-be0b-\
55d6a7ee75a7"],

Cell[CellGroupData[{

Cell["Treatment of the point at s=-196", "Section",
 CellChangeTimes->{{3.996919924000721*^9, 3.9969199620575542`*^9}, {
  3.996920778097868*^9, 3.9969207791948853`*^9}, {3.996983595906986*^9, 
  3.9969836007334833`*^9}},ExpressionUUID->"1834f11b-6f1c-482c-91b6-\
aa7c293b676c"],

Cell["\<\
First we compute the corresponding differential equation (in our \
implementation the equation will be in z (replacing z->s+196 gives the \
expansion at s=-196).\
\>", "Text",
 CellChangeTimes->{{3.9969819295412197`*^9, 3.9969819496863937`*^9}, {
  3.9983078255925207`*^9, 
  3.9983078502142553`*^9}},ExpressionUUID->"fdb5fdf0-9f5b-469c-8f37-\
2f7a99753b8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LaunchKernels", "[", "10", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.998965420372882*^9, 3.998965424795865*^9}, 
   3.999002137177176*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"8afff8be-3f96-4540-86e8-1ef40f7001f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deq", "=", 
   RowBox[{"ParallelGetDEQspt", "[", 
    RowBox[{"deS0", ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", 
       RowBox[{"-", "196"}]}], "}"}], ",", "g", ",", "z", ",", "10"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996919950536559*^9, 3.996919951097609*^9}, {
   3.996920375431654*^9, 3.996920444151181*^9}, 3.996920485231155*^9, {
   3.996920587616809*^9, 3.996920589338251*^9}, {3.9969207849228*^9, 
   3.9969207966097918`*^9}, {3.9969209862760773`*^9, 
   3.9969209888052387`*^9}, {3.9979511549413977`*^9, 
